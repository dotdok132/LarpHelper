                    extra_web_context=web_context)
    print()


def cmd_fix(args: list = None) -> bool:
    """Diagnoses critical system logs. Returns True only if a repair command actually ran."""
    print_banner()
    print(f"{CYAN}Reading recent critical system logs...{RESET}\n")

    logs = ""
    try:
        if shutil.which("journalctl"):
            cmd = ["journalctl", "-p", "3", "-n", "20", "--no-pager"]
            res = subprocess.run(cmd, capture_output=True, text=True, check=False)
            logs = res.stdout.strip()
        else:
            res = subprocess.run("dmesg -T -l err,crit,alert,emerg 2>/dev/null | tail -n 20", shell=True, capture_output=True, text=True, check=False)
            logs = res.stdout.strip()
            if not logs and os.path.exists("/var/log/messages"):
                with open("/var/log/messages", "r", errors="ignore") as f:
                    logs = "".join(f.readlines()[-20:]).strip()
    except Exception as e:
        print(f"{RED}[-] Error reading logs: {e}{RESET}")
        sys.exit(1)

    if not logs:
        print(f"{GREEN}[+] No critical system errors found in system logs! System is stable.{RESET}\n")
        return False

    prompt = (
        f"Here are the 20 most recent critical system logs:\n\n"
        f"```\n{logs}\n```\n\n"
        f"1. Explain the root cause in 2-3 brief sentences.\n"
        f"2. Provide an exact one-liner bash resolution command formatted as: FIX_CMD: <fix_command>"
    )

    response = ask_ai_quietly(prompt)
    if not response:
        return False
    config = load_config()
    p_name = config.get("provider", "ollama").upper()

    fix_tokens = [
        "sudo systemctl", "sudo rc-service", "sudo sv", "sudo dinitctl", "sudo service",
        "systemctl", "sudo pacman", "sudo apt", "sudo dnf", "sudo zypper", "sudo apk",
        "sudo xbps-install", "sudo rm", "sudo chmod", "sudo sed", "sudo journalctl",
    ]

    clean_lines = []
    cmd_to_fix = ""

    for line in response.splitlines():
        if "FIX_CMD:" in line:
            extracted = line.split("FIX_CMD:")[1].strip()
            cmd_to_fix = sanitize_shell_command(extracted)
            continue
        if not cmd_to_fix:
            # Only whole lines that *start* with a command; prose that merely
            # mentions one ("then run sudo rm ... to clear it") is not a command.
            extracted = extract_command_from_line(line, fix_tokens)
            if extracted:
                cmd_to_fix = sanitize_shell_command(extracted)
        clean_lines.append(line)

    print_box(f"Diagnostics & Resolution [{p_name}]", "\n".join(clean_lines), border_color=PINK)
    print()

    if not cmd_to_fix:
        return False

    print(f"{CYAN}Proposed repair command:{RESET}\n  {BOLD}{cmd_to_fix}{RESET}\n")
    auto_yes = (args and any(a in ["-y", "--yes"] for a in args)) or config.get("auto_fix", False)
    try:
        if not auto_yes:
            ans = input(f"{PINK}Execute proposed repair command? (y/N): {RESET}").strip().lower()
            should_run = ans in ["y", "yes", "yeah"]
        else:
            print(f"{GREEN}[Auto-Repair Engine] Auto-Repair enabled in config. Applying fixes...{RESET}")
            should_run = True

        # A destructive command needs an explicit typed confirmation even when
        # auto_fix is on — auto_fix should not be able to wipe a disk unattended.
        if should_run and not confirm_destructive(cmd_to_fix):
            return False

        if should_run:
            print(f"\n{CYAN}Executing repair command...{RESET}\n")
            res = subprocess.run(cmd_to_fix, shell=True)
            if res.returncode == 0:
                print(f"\n{GREEN}[+] System repair applied successfully!{RESET}\n")
            else:
                print(f"\n{RED}[-] Repair command exited with code {res.returncode}.{RESET}\n")
            return True
    except (KeyboardInterrupt, EOFError):
        print("\nCancelled.")

    return False


def cmd_get(args: list):
    if not args or args[0] in ["--list", "-l", "list"]:
        cmd_get_list()
        return

    pkg_name = args[0].lower()
    print_banner()
    recipes = get_all_recipes()

    if pkg_name in recipes:
        recipe = recipes[pkg_name]
        cmd_str = recipe["cmd"]
        desc = recipe["desc"]

        print(f"{PINK}[Larp-Repo]{RESET} {CYAN}Running build recipe:{RESET} {BOLD}{pkg_name}{RESET} ({desc})")
        print(f"{DIM}Executing command: {cmd_str}{RESET}\n")
        try:
            res = subprocess.run(cmd_str, shell=True)
            if res.returncode == 0:
                print(f"\n{GREEN}[+] Recipe '{pkg_name}' installed successfully!{RESET}\n")
            else:
                print(f"\n{RED}[-] Error installing package '{pkg_name}' (exit code: {res.returncode}){RESET}\n")
        except Exception as e:
            print(f"\n{RED}[-] Execution error: {e}{RESET}\n")
    else:
        print(f"{PINK}[Larp-Repo]{RESET} {CYAN}Searching recipe registry for:{RESET} {BOLD}{pkg_name}{RESET}")
        print(f"{DIM}─── Scanning official Larp repository...{RESET}")
        time.sleep(0.3)
        print(f"\n{LIGHT_PINK}Recipe '{pkg_name}' not found in Larp-Repo registry.{RESET}")
        print(f"{DIM}You can generate it automatically using: {RESET}{CYAN}larp get-create {pkg_name}{RESET}\n")


def main():
    if len(sys.argv) < 2:
        cmd_help()
        sys.exit(0)

    subcommand = sys.argv[1].lower()
    args = sys.argv[2:]

    if subcommand in ["talk", "chat-voice"]:
        cmd_talk()
    elif subcommand == "voice":
        cmd_voice(args)
    elif subcommand in ["listen", "rec", "record"]:
        cmd_listen(args)
    elif subcommand in ["speak", "say", "tts"]:
        cmd_speak(args)
    elif subcommand in ["help", "-h", "--help"]:
        cmd_help()
    elif subcommand in ["version", "--version", "-V"]:
        print(f"larp {__version__}")
    elif subcommand in ["fetch", "neofetch"]:
        cmd_fetch()
    elif subcommand in ["code", "script"]:
        cmd_code(args)
    elif subcommand in ["translate", "tr"]:
        cmd_translate(args)
    elif subcommand in ["backup", "snapshot"]:
        cmd_backup()
    elif subcommand == "restore":
        cmd_restore(args)
    elif subcommand in ["alias", "setup-aliases"]:
        cmd_alias()
    elif subcommand == "config":
        cmd_config(args)
    elif subcommand in ["fallback", "chain"]:
        cmd_fallback(args)
    elif subcommand == "do":
        cmd_do(args)
    elif subcommand == "clean":
        cmd_clean()
    elif subcommand in ["bench", "benchmark", "speedtest"]:
        cmd_bench()
    elif subcommand in ["history", "hist", "logs"]:
        cmd_history()
    elif subcommand == "status":
        cmd_status()
    elif subcommand in ["monitor", "top"]:
        cmd_monitor()
    elif subcommand == "chat":
        cmd_chat()
    elif subcommand == "why":
        cmd_why(args)
    elif subcommand == "fix":
        cmd_fix(args)
    elif subcommand == "get":
        cmd_get(args)
    elif subcommand in ["get-list", "list", "packs"]:
        cmd_get_list()
    elif subcommand in ["get-create", "create-pack", "create"]:
        cmd_get_create(args)
    else:
        print(f"{RED}[-] Unknown command: '{subcommand}'{RESET}\n")
        cmd_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
