class Spinner:
    """Animated Braille console spinner."""
    def __init__(self, message="Loading..."):
        self.message = message
        self.running = False
        self.thread = None
        self.frames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]

    def _spin(self):
        idx = 0
        while self.running:
            frame = self.frames[idx % len(self.frames)]
            sys.stdout.write(f"\r{PINK}{frame}{RESET} {CYAN}{self.message}{RESET}")
            sys.stdout.flush()
            time.sleep(0.08)
            idx += 1
        sys.stdout.write(f"\r{' ' * (len(self.message) + 12)}\r")
        sys.stdout.flush()

    def start(self):
        self.running = True
        self.thread = threading.Thread(target=self._spin)
        self.thread.daemon = True
        self.thread.start()

    def stop(self):
        self.running = False
        if self.thread:
            self.thread.join()


def print_banner():
    banner = f"""
{PINK}{BOLD}  ╭───╮   {DEEP_PINK} █░░ █▀█ █▀█ █▀█ █░░ ░▀█ █▄░█ █░█ █░█{RESET}
{PINK}{BOLD}  │   │   {DEEP_PINK} █▄▄ █▀█ █▀▄ █▀▀ █▄▄ █▄█ █░▀█ █▄█ ▄▀▄{RESET}
{PINK}{BOLD}  ╰───╯   {CYAN}─── LarpLinux OS Supreme AI Companion ───{RESET}
"""
    print(banner)


def print_box(title: str, text: str, border_color: str = PINK):
    lines = text.splitlines()
    term_width = min(shutil.get_terminal_size((80, 20)).columns - 4, 90)
    
    top = f"{border_color}╭─ {BOLD}{WHITE}{title}{RESET} " + f"{border_color}─" * max(0, term_width - len(title) - 4) + f"╮{RESET}"
    bottom = f"{border_color}╰" + "─" * max(0, term_width - 2) + f"╯{RESET}"
    
    print(top)
    for line in lines:
        print(f"{border_color}│{RESET} {line}")
    print(bottom)


def build_system_prompt() -> str:
    """Cute 'nyashka' Linux AI persona using ONLY safe ASCII kaomoji that render cleanly in terminal fonts."""
    return (
        r"You are Larp AI, a super cute, warm, friendly, and enthusiastic AI companion for Linux!" "\n\n"
        r"PERSONALITY & BEHAVIOR:" "\n"
        r"1. Be adorable, friendly, warm, and helpful (a true cute companion / няшка)! Never be a boring, stiff, or robotic 'dushnila'." "\n"
        r"2. TERMINAL FONT & KAOMOJI RULE: NEVER use graphic emojis OR rare CJK Unicode symbols that result in broken boxes or missing characters in terminal fonts! ONLY use safe 100% standard ASCII kaomoji that render cleanly in any Linux console (such as (^_^), (^--^), (o_O), (x_x), (=^.^=), \(^o^)/, (>-<), (¬_¬), (-_-;))." "\n"
        r"3. Do NOT mention any desktop environments, window managers, or personal user details unless the user explicitly asks about them." "\n"
        r"4. Provide accurate, safe, and verified Linux commands for Arch Linux / pacman / AUR / systemd." "\n"
        r"5. NEVER suggest Windows-specific tools or concepts (no sfc, chkdsk, bsod)." "\n"
        r"6. ALWAYS respond in the EXACT SAME LANGUAGE as the user's message (e.g., reply in Russian if asked in Russian)."
    )


def sanitize_shell_command(cmd: str) -> str:
    """Sanitizes and balances quotes in AI-generated bash commands."""
    if not cmd:
        return ""
    cmd = cmd.strip()
    cmd = re.sub(r'^`+|`+$', '', cmd).strip()
    cmd = re.sub(r'^bash\s+', '', cmd).strip()

    # Balance single quotes
    if cmd.count("'") % 2 != 0:
        if cmd.endswith("'"):
            cmd = cmd[:-1]
        else:
            cmd += "'"

    # Balance double quotes
    if cmd.count('"') % 2 != 0:
        if cmd.endswith('"'):
            cmd = cmd[:-1]
        else:
            cmd += '"'

    return cmd.strip()


def load_config() -> dict:
    config = json.loads(json.dumps(DEFAULT_CONFIG))
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                user_conf = json.load(f)
                def deep_update(d, u):
                    for k, v in u.items():
                        if isinstance(v, dict) and k in d:
                            deep_update(d[k], v)
                        else:
                            d[k] = v
                deep_update(config, user_conf)
        except Exception:
            pass
    return config


def save_config(config: dict):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    try:
        with open(CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(config, f, ensure_ascii=False, indent=2)
        print(f"{GREEN}[+] Configuration saved successfully!{RESET}")
    except Exception as e:
        print(f"{RED}[-] Error saving configuration: {e}{RESET}")


def save_history_entry(query: str, response: str, provider: str):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    history = []
    if os.path.exists(HISTORY_FILE):
        try:
            with open(HISTORY_FILE, "r", encoding="utf-8") as f:
                history = json.load(f)
        except Exception:
            history = []
    
    history.append({
        "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),
        "provider": provider,
        "query": query,
        "response": response[:300] + ("..." if len(response) > 300 else "")
    })
    
    history = history[-50:]
    try:
        with open(HISTORY_FILE, "w", encoding="utf-8") as f:
            json.dump(history, f, ensure_ascii=False, indent=2)
    except Exception:
        pass


def load_custom_recipes() -> dict:
    if os.path.exists(CUSTOM_RECIPES_FILE):
        try:
            with open(CUSTOM_RECIPES_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return {}
    return {}


def save_custom_recipe(name: str, desc: str, cmd: str):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    customs = load_custom_recipes()
    customs[name] = {"desc": desc, "cmd": cmd}
    try:
        with open(CUSTOM_RECIPES_FILE, "w", encoding="utf-8") as f:
            json.dump(customs, f, ensure_ascii=False, indent=2)
        print(f"{GREEN}[+] Recipe '{name}' saved to your collection!{RESET}")
    except Exception as e:
        print(f"{RED}[-] Error saving recipe: {e}{RESET}")


def get_all_recipes() -> dict:
    recipes = dict(KNOWN_RECIPES)
    customs = load_custom_recipes()
    for k, v in customs.items():
        recipes[k] = v
    return recipes


def extract_search_keywords(text: str) -> str:
    stop_words = {
        "why", "how", "what", "where", "when", "who", "is", "the",
        "best", "a", "an", "in", "on", "for", "please", "explain", "tell",
        "show", "can", "you", "does", "do", "which"
    }
    words = re.findall(r'\w+', text.lower())
    filtered = [w for w in words if w not in stop_words and len(w) > 1]
    return " ".join(filtered) if filtered else text


def web_search_duckduckgo(query: str) -> list:
    clean_query = extract_search_keywords(query)
    if not clean_query or len(clean_query.strip()) < 3:
        clean_query = f"{query} linux"

    results = []
    try:
        url = f"https://html.duckduckgo.com/html/?q={urllib.parse.quote(clean_query)}"
        req = urllib.request.Request(
            url,
            headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64; rv:120.0) Gecko/20100101 Firefox/120.0"}
        )
        with urllib.request.urlopen(req, timeout=5) as resp:
            html = resp.read().decode("utf-8", errors="ignore")
            snippets = re.findall(r'<a class="result__snippet[^>]*>(.*?)</a>', html, re.DOTALL)
            clean_snippets = [re.sub(r'<[^>]+>', '', s).strip() for s in snippets[:4]]
            for snippet in clean_snippets:
                if snippet and len(snippet) > 15:
                    results.append(snippet)
    except Exception:
        pass
    return results


def search_arch_packages_api(query: str) -> list:
    clean_query = extract_search_keywords(query)
    if not clean_query or len(clean_query.strip()) < 3:
        return []
    pkgs = []
    try:
        url = f"https://archlinux.org/packages/search/json/?q={urllib.parse.quote(clean_query)}"
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=4) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            for item in data.get("results", [])[:5]:
                pkgs.append(f"{item['pkgname']} — {item['pkgdesc']}")
    except Exception:
        pass
    return pkgs


def search_aur_packages_api(query: str) -> list:
    clean_query = extract_search_keywords(query)
    if not clean_query or len(clean_query.strip()) < 3:
        return []
    pkgs = []
    try:
        url = f"https://aur.archlinux.org/rpc/?v=5&type=search&arg={urllib.parse.quote(clean_query)}"
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=4) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            for item in data.get("results", [])[:5]:
                pkgs.append(f"{item['Name']} (AUR) — {item.get('Description', '')}")
    except Exception:
        pass
    return pkgs


def get_full_web_context(query: str) -> str:
    config = load_config()
    if not config.get("web_search", True):
        return ""

    context_blocks = []

    snippets = web_search_duckduckgo(query)
    if snippets:
        context_blocks.append("Web Search Results (DuckDuckGo):\n" + "\n".join(f"• {s}" for s in snippets))

    arch_pkgs = search_arch_packages_api(query)
    aur_pkgs = search_aur_packages_api(query)
    combined_pkgs = arch_pkgs + aur_pkgs
    if combined_pkgs:
        context_blocks.append("Found Arch/AUR Packages:\n" + "\n".join(f" - {p}" for p in combined_pkgs[:7]))

    return "\n\n".join(context_blocks)


def get_system_info() -> str:
    info_lines = []

    user = os.environ.get("USER", "user")
    host = os.environ.get("HOSTNAME", "larplinux")
    info_lines.append(f"User/Host: {user}@{host}")

    if os.path.exists("/etc/os-release"):
        try:
            with open("/etc/os-release", "r") as f:
                for line in f:
                    if line.startswith("PRETTY_NAME="):
                        info_lines.append(f"OS: {line.split('=')[1].strip().strip('\"')}")
                        break
        except Exception:
            pass

    try:
        kernel = subprocess.check_output(["uname", "-sr"], text=True).strip()
        info_lines.append(f"Linux Kernel: {kernel}")
    except Exception:
        pass

    xdg_desktop = os.environ.get("XDG_CURRENT_DESKTOP", "")
    wayland_disp = os.environ.get("WAYLAND_DISPLAY", "")
    info_lines.append(f"Graphics/DE: {xdg_desktop or 'Wayland'} (WAYLAND_DISPLAY={wayland_disp or 'wayland-0'})")

    shell = os.environ.get("SHELL", "/bin/bash")
    info_lines.append(f"Shell: {shell}")

    try:
        cpu_cmd = "grep -m1 'model name' /proc/cpuinfo | cut -d: -f2"
        cpu = subprocess.check_output(cpu_cmd, shell=True, text=True).strip()
        if cpu:
            info_lines.append(f"CPU: {cpu}")
    except Exception:
        pass

    try:
        with open("/proc/meminfo", "r") as f:
            lines = f.readlines()
            total_kb = int(lines[0].split()[1])
            avail_kb = int(lines[2].split()[1])
            total_gb = round(total_kb / 1024 / 1024, 1)
            avail_gb = round(avail_kb / 1024 / 1024, 1)
            info_lines.append(f"RAM: {avail_gb} GB free of {total_gb} GB")
    except Exception:
        pass

    return "\n".join(info_lines)


def get_available_ollama_models(ollama_url: str) -> list:
    try:
        req = urllib.request.Request(f"{ollama_url}/api/tags", method="GET")
        with urllib.request.urlopen(req, timeout=2) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return [m.get("name", "").split(":")[0] for m in data.get("models", [])]
    except Exception:
        return []


def check_ollama_status(ollama_url: str) -> bool:
    try:
        req = urllib.request.Request(ollama_url, method="GET")
        with urllib.request.urlopen(req, timeout=2):
            return True
    except Exception:
        return False


def ensure_ollama_and_get_model(config: dict) -> str:
    global OLLAMA_STARTED_BY_LARP
    ollama_conf = config.get("ollama", {})
    ollama_url = ollama_conf.get("url", OLLAMA_URL)
    target_model = ollama_conf.get("model", DEFAULT_MODEL)

    if not check_ollama_status(ollama_url):
        print(f"{PINK}Ollama is not running. Starting Ollama daemon...{RESET}")
        OLLAMA_STARTED_BY_LARP = True
        
        res = subprocess.run(["systemctl", "start", "ollama"], capture_output=True, text=True)
        if res.returncode != 0:
            try:
                subprocess.Popen(["ollama", "serve"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception as e:
                print(f"{RED}[-] Error launching Ollama processes: {e}{RESET}")

        started = False
        for _ in range(10):
            time.sleep(1)
            if check_ollama_status(ollama_url):
                started = True
                break

        if not started:
            print(f"{YELLOW}[!] Could not connect to Ollama on {ollama_url}{RESET}")
            sys.exit(1)
        else:
            print(f"{GREEN}[+] Ollama service started successfully!{RESET}\n")

    models = get_available_ollama_models(ollama_url)
    if target_model in models:
        return target_model

    if not models:
        print(f"{PINK}Model '{target_model}' not found. Pulling model (ollama pull {target_model})...{RESET}")
        pull_res = subprocess.run(["ollama", "pull", target_model])
        if pull_res.returncode != 0:
            print(f"{RED}[-] Failed to pull model {target_model}.{RESET}")
            sys.exit(1)
        return target_model

    priority_order = [target_model, "mistral", "dolphin-mistral", "llama3.2-uncensored", "hermes3", "qwen2.5-coder", "gemma4"]
    for p in priority_order:
        if p in models:
            return p

    return models[0]


def stop_ollama_and_free_vram():
    global OLLAMA_STARTED_BY_LARP
    if OLLAMA_STARTED_BY_LARP:
        try:
            subprocess.run(["systemctl", "stop", "ollama"], capture_output=True, text=True, check=False)
        except Exception:
            pass
        OLLAMA_STARTED_BY_LARP = False


def get_valid_gemini_models_from_api(api_key: str) -> list:
    """Queries Google ModelService.ListModels API for valid text generation models."""
    try:
        url = f"https://generativelanguage.googleapis.com/v1beta/models?key={api_key}"
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=8) as resp:
            if resp.status == 200:
                data = json.loads(resp.read().decode("utf-8"))
                valid_models = []
                for m in data.get("models", []):
                    name = m.get("name", "").replace("models/", "")
                    methods = m.get("supportedGenerationMethods", [])
                    if "generateContent" in methods and not any(bad in name.lower() for bad in ["-tts", "embedding", "imagen", "bison", "aqa"]):
                        valid_models.append(name)
                return valid_models
    except Exception:
        pass
    return []


# =============================================================================
# UNIVERSAL PROVIDERS ENGINE (Ollama, Gemini API, Claude API, OpenAI API)
# =============================================================================

def query_provider_ollama(prompt: str, extra_web_context: str, config: dict) -> str:
    ollama_conf = config.get("ollama", {})
    ollama_url = ollama_conf.get("url", OLLAMA_URL)
    active_model = ensure_ollama_and_get_model(config)

    sys_context = get_system_info()
    full_prompt = f"[SYSTEM & USER CONTEXT]\n{sys_context}\n\n"
    if extra_web_context:
        full_prompt += f"[WEB SEARCH CONTEXT]\n{extra_web_context}\n\n"
    full_prompt += f"[USER PROMPT]\n{prompt}"

    payload = {
        "model": active_model,
        "prompt": full_prompt,
        "system": build_system_prompt(),
        "stream": False,
        "keep_alive": ollama_conf.get("keep_alive", 0)
    }

    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        f"{ollama_url}/api/generate",
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST"
    )

    spinner = Spinner(f"Larp AI [Ollama/{active_model}] generating response...")
    spinner.start()

    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            spinner.stop()
            if resp.status == 200:
                result = json.loads(resp.read().decode("utf-8"))
                response_text = result.get("response", "").strip()
                stop_ollama_and_free_vram()
                return response_text
            else:
                stop_ollama_and_free_vram()
                return f"{RED}Ollama Error: HTTP status {resp.status}{RESET}"
    except Exception as e:
        spinner.stop()
        stop_ollama_and_free_vram()
        return f"{RED}Ollama Connection Error: {e}{RESET}"


def query_provider_gemini(prompt: str, extra_web_context: str, config: dict) -> str:
    gemini_conf = config.get("gemini", {})
    api_key = gemini_conf.get("api_key", "").strip()
    user_model = gemini_conf.get("model", "auto").strip()

    if not api_key:
        return (f"{RED}[-] Error: Gemini API Key is not set!\n{RESET}"
                f"{CYAN}Run {BOLD}larp config{RESET}{CYAN} to set up your API key.{RESET}")

    sys_context = get_system_info()
    full_prompt = f"[SYSTEM & USER CONTEXT]\n{sys_context}\n\n"
    if extra_web_context:
        full_prompt += f"[WEB SEARCH CONTEXT]\n{extra_web_context}\n\n"
    full_prompt += f"[USER PROMPT]\n{prompt}"

    payload = {
        "system_instruction": {
            "parts": [{"text": build_system_prompt()}]
        },
        "contents": [
            {
                "parts": [{"text": full_prompt}]
            }
        ]
    }
    data = json.dumps(payload).encode("utf-8")

    spinner = Spinner(f"Larp AI [Google Gemini] generating response...")
    spinner.start()

    discovered_models = get_valid_gemini_models_from_api(api_key)

    def rank_model(m_name: str) -> int:
        name = m_name.lower()
        if name == "gemini-1.5-flash":
            return 0
        elif name == "gemini-2.0-flash":
            return 1
        elif name == "gemini-1.5-pro":
            return 2
        elif "flash" in name and "preview" not in name:
            return 3
        elif "flash" in name:
            return 4
        elif "pro" in name:
            return 5
        return 10

    if discovered_models:
        discovered_models.sort(key=rank_model)

    candidate_models = []
    if user_model and user_model != "auto" and not any(bad in user_model.lower() for bad in ["-tts", "embedding", "imagen"]):
        candidate_models.append(user_model)

    if discovered_models:
        candidate_models.extend(discovered_models)

    fallback_defaults = ["gemini-1.5-flash", "gemini-2.0-flash", "gemini-1.5-flash-latest", "gemini-1.5-pro", "gemini-pro"]
    candidate_models.extend(fallback_defaults)

    seen = set()
    candidate_models = [m for m in candidate_models if m and not (m in seen or seen.add(m))]

    last_error = ""
    for model in candidate_models:
        endpoint = f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={api_key}"
        req = urllib.request.Request(
            endpoint,
            data=data,
            headers={"Content-Type": "application/json"},
            method="POST"
        )
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                spinner.stop()
                if resp.status == 200:
                    result = json.loads(resp.read().decode("utf-8"))
                    candidates = result.get("candidates", [])
                    if candidates:
                        parts = candidates[0].get("content", {}).get("parts", [])
                        if parts:
                            return parts[0].get("text", "").strip()
        except urllib.error.HTTPError as e:
            last_error = e.read().decode("utf-8", errors="ignore")
            if e.code in [400, 404, 429, 500, 502, 503, 504]:
                continue
            else:
                spinner.stop()
                return f"{RED}Gemini API Error ({e.code}): {last_error}{RESET}"
        except Exception as e:
            spinner.stop()
            return f"{RED}Gemini API Request Error: {e}{RESET}"

    spinner.stop()
    return f"{RED}Gemini API Error: None of the models {candidate_models[:4]} matched your API key.\nDetails: {last_error}{RESET}"


def query_provider_claude(prompt: str, extra_web_context: str, config: dict) -> str:
    claude_conf = config.get("claude", {})
    api_key = claude_conf.get("api_key", "").strip()
    model = claude_conf.get("model", "claude-3-5-sonnet-20241022").strip()

    if not api_key:
        return (f"{RED}[-] Error: Anthropic Claude API Key is not set!\n{RESET}"
                f"{CYAN}Run {BOLD}larp config{RESET}{CYAN} to set up your API key.{RESET}")

    sys_context = get_system_info()
    full_prompt = f"[SYSTEM & USER CONTEXT]\n{sys_context}\n\n"
    if extra_web_context:
        full_prompt += f"[WEB SEARCH CONTEXT]\n{extra_web_context}\n\n"
    full_prompt += f"[USER PROMPT]\n{prompt}"

    endpoint = "https://api.anthropic.com/v1/messages"

    payload = {
        "model": model,
        "max_tokens": 1024,
        "system": build_system_prompt(),
        "messages": [
            {"role": "user", "content": full_prompt}
        ]
    }

    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        endpoint,
        data=data,
        headers={
            "x-api-key": api_key,
            "anthropic-version": "2023-06-01",
            "content-type": "application/json"
        },
        method="POST"
    )

    spinner = Spinner(f"Larp AI [Anthropic Claude/{model}] generating response...")
    spinner.start()

    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            spinner.stop()
            if resp.status == 200:
                result = json.loads(resp.read().decode("utf-8"))
                contents = result.get("content", [])
                if contents:
                    return contents[0].get("text", "").strip()
                return f"{RED}Empty response from Claude API.{RESET}"
            else:
                return f"{RED}Claude API Error: HTTP status {resp.status}{RESET}"
    except urllib.error.HTTPError as e:
        spinner.stop()
        err_msg = e.read().decode("utf-8", errors="ignore")
        return f"{RED}Claude API Error ({e.code}): {err_msg}{RESET}"
    except Exception as e:
        spinner.stop()
        return f"{RED}Claude API Request Error: {e}{RESET}"


def query_provider_openai(prompt: str, extra_web_context: str, config: dict) -> str:
    openai_conf = config.get("openai", {})
    api_key = openai_conf.get("api_key", "").strip()
    model = openai_conf.get("model", "gpt-4o-mini").strip()

    if not api_key:
        return (f"{RED}[-] Error: OpenAI API Key is not set!\n{RESET}"
                f"{CYAN}Run {BOLD}larp config{RESET}{CYAN} to set up your API key.{RESET}")

    sys_context = get_system_info()
    full_prompt = f"[SYSTEM & USER CONTEXT]\n{sys_context}\n\n"
    if extra_web_context:
        full_prompt += f"[WEB SEARCH CONTEXT]\n{extra_web_context}\n\n"
    full_prompt += f"[USER PROMPT]\n{prompt}"

    endpoint = "https://api.openai.com/v1/chat/completions"

    payload = {
        "model": model,
        "messages": [
            {"role": "system", "content": build_system_prompt()},
            {"role": "user", "content": full_prompt}
        ]
    }

    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        endpoint,
        data=data,
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json"
        },
        method="POST"
    )

    spinner = Spinner(f"Larp AI [OpenAI/{model}] generating response...")
    spinner.start()

    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            spinner.stop()
            if resp.status == 200:
                result = json.loads(resp.read().decode("utf-8"))
                choices = result.get("choices", [])
                if choices:
                    return choices[0].get("message", {}).get("content", "").strip()
                return f"{RED}Empty response from OpenAI API.{RESET}"
            else:
                return f"{RED}OpenAI API Error: HTTP status {resp.status}{RESET}"
    except urllib.error.HTTPError as e:
        spinner.stop()
        err_msg = e.read().decode("utf-8", errors="ignore")
        return f"{RED}OpenAI API Error ({e.code}): {err_msg}{RESET}"
    except Exception as e:
        spinner.stop()
        return f"{RED}OpenAI API Request Error: {e}{RESET}"


def query_ollama(prompt: str, extra_web_context: str = "") -> str:
    config = load_config()
    provider = config.get("provider", "ollama").lower()

    if provider == "gemini":
        res = query_provider_gemini(prompt, extra_web_context, config)
    elif provider == "claude":
        res = query_provider_claude(prompt, extra_web_context, config)
    elif provider == "openai":
        res = query_provider_openai(prompt, extra_web_context, config)
    else:
        res = query_provider_ollama(prompt, extra_web_context, config)

    save_history_entry(prompt, res, provider)
    return res


