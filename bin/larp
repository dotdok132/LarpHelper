# =============================================================================
# CONFIG BACKUP & SNAPSHOT (`larp backup`)
# =============================================================================

def cmd_backup():
    """Creates a compressed archive of LarpLinux configurations."""
    print_banner()
    os.makedirs(BACKUPS_DIR, exist_ok=True)
    stamp = time.strftime("%Y%m%d_%H%M%S")
    tar_path = os.path.join(BACKUPS_DIR, f"larp-config-backup-{stamp}.tar.gz")

    print(f"{CYAN}Creating backup of LarpLinux configurations...{RESET}")

    targets = [
        os.path.expanduser("~/.config/larp"),
        os.path.expanduser("~/.config/niri"),
        os.path.expanduser("~/.config/fwm"),
        os.path.expanduser("~/.config/waybar"),
        os.path.expanduser("~/.config/kitty")
    ]

    with tarfile.open(tar_path, "w:gz") as tar:
        for t in targets:
            if os.path.exists(t):
                tar.add(t, arcname=os.path.basename(t))

    size_mb = round(os.path.getsize(tar_path) / 1024 / 1024, 2)
    print(f"{GREEN}[+] Backup archive created successfully!{RESET}")
    print(f"  {CYAN}File:{RESET} {tar_path}")
    print(f"  {CYAN}Size:{RESET} {size_mb} MB\n")


