# =============================================================================
# CONFIG BACKUP & SNAPSHOT (`larp backup`)
# =============================================================================

BACKUP_TARGETS = [
    "~/.config/larp",
    "~/.config/niri",
    "~/.config/fwm",
    "~/.config/waybar",
    "~/.config/kitty",
]

KEEP_BACKUPS = 10


def list_backups() -> list:
    """Returns existing backup archives, newest first."""
    if not os.path.isdir(BACKUPS_DIR):
        return []
    archives = [
        os.path.join(BACKUPS_DIR, name)
        for name in os.listdir(BACKUPS_DIR)
        if name.startswith("larp-config-backup-") and name.endswith(".tar.gz")
    ]
    return sorted(archives, key=os.path.getmtime, reverse=True)


def cmd_backup():
    """Creates a compressed archive of Larp Linux configurations."""
    print_banner()
    os.makedirs(BACKUPS_DIR, exist_ok=True)
    os.chmod(BACKUPS_DIR, 0o700)
    stamp = time.strftime("%Y%m%d_%H%M%S")
    tar_path = os.path.join(BACKUPS_DIR, f"larp-config-backup-{stamp}.tar.gz")

    print(f"{CYAN}Creating backup of Linux configurations...{RESET}")

    # The archive contains ~/.config/larp/config.json, which holds API keys in
    # clear text. Creating it 0600 from the start (rather than chmod'ing after)
    # means the keys are never briefly world-readable.
    fd = os.open(tar_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as raw:
        with tarfile.open(fileobj=raw, mode="w:gz") as tar:
            for target in BACKUP_TARGETS:
                path = os.path.expanduser(target)
                if os.path.exists(path):
                    tar.add(path, arcname=os.path.basename(path))

    size_mb = round(os.path.getsize(tar_path) / 1024 / 1024, 2)
    print(f"{GREEN}[+] Backup archive created successfully!{RESET}")
    print(f"  {CYAN}File:{RESET} {tar_path}")
    print(f"  {CYAN}Size:{RESET} {size_mb} MB")
    print(f"  {DIM}Permissions: 0600 — the archive contains your API keys.{RESET}")

    stale = list_backups()[KEEP_BACKUPS:]
    for path in stale:
        try:
            os.remove(path)
        except OSError:
            pass
    if stale:
        print(f"  {DIM}Pruned {len(stale)} old backup(s), keeping the newest {KEEP_BACKUPS}.{RESET}")
    print(f"\n{DIM}Restore with: larp restore{RESET}\n")


def cmd_restore(args: list):
    """Restores configuration from a backup archive — the other half of `larp backup`."""
    print_banner()
    backups = list_backups()
    if not backups:
        print(f"{YELLOW}[!] No backups found in {BACKUPS_DIR}.{RESET}")
        print(f"{DIM}Create one with: larp backup{RESET}\n")
        return

    if args:
        archive = args[0] if os.path.isabs(args[0]) else os.path.join(BACKUPS_DIR, args[0])
        if not os.path.exists(archive):
            print(f"{RED}[-] No such backup: {archive}{RESET}\n")
            return
    else:
        lines = []
        for index, path in enumerate(backups[:KEEP_BACKUPS], 1):
            when = time.strftime("%Y-%m-%d %H:%M", time.localtime(os.path.getmtime(path)))
            size_mb = round(os.path.getsize(path) / 1024 / 1024, 2)
            lines.append(f"  {PINK}{index}.{RESET} {os.path.basename(path)} "
                         f"{DIM}({when}, {size_mb} MB){RESET}")
        print_box("Available Backups", "\n".join(lines), border_color=CYAN)
        print()
        try:
            choice = input(f"{PINK}Restore which backup? [1-{len(lines)}, Enter to cancel]: {RESET}").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nCancelled.")
            return
        if not choice.isdigit() or not 1 <= int(choice) <= len(lines):
            print(f"{GREEN}[+] Cancelled — nothing was restored.{RESET}\n")
            return
        archive = backups[int(choice) - 1]

    target_dir = os.path.expanduser("~/.config")
    print(f"\n{YELLOW}[!] This overwrites existing files under {target_dir} "
          f"with the contents of the archive.{RESET}")
    try:
        answer = input(f"{PINK}Continue? (y/N): {RESET}").strip().lower()
    except (KeyboardInterrupt, EOFError):
        print("\nCancelled.")
        return
    if answer not in ["y", "yes", "yeah"]:
        print(f"{GREEN}[+] Cancelled — nothing was restored.{RESET}\n")
        return

    try:
        with tarfile.open(archive, "r:gz") as tar:
            members = [m for m in tar.getmembers() if is_safe_member(m)]
            skipped = len(tar.getmembers()) - len(members)
            # Python 3.12+ warns unless the extraction filter is explicit.
            try:
                tar.extractall(target_dir, members=members, filter="data")
            except TypeError:
                tar.extractall(target_dir, members=members)
    except Exception as e:
        print(f"{RED}[-] Restore failed: {e}{RESET}\n")
        return

    if skipped:
        print(f"{YELLOW}[!] Skipped {skipped} unsafe path(s) in the archive.{RESET}")
    print(f"{GREEN}[+] Restored {os.path.basename(archive)} into {target_dir}.{RESET}\n")


def is_safe_member(member) -> bool:
    """Rejects archive members that would write outside the target directory.

    A tar can contain absolute paths, "..", or symlinks pointing anywhere on the
    filesystem; extracting those blindly lets a tampered archive overwrite files
    far outside ~/.config.
    """
    name = member.name
    if name.startswith("/") or os.path.isabs(name):
        return False
    if any(part == ".." for part in name.replace("\\", "/").split("/")):
        return False
    if member.issym() or member.islnk():
        link = member.linkname
        if os.path.isabs(link) or any(part == ".." for part in link.split("/")):
            return False
    return True


# =============================================================================
# SHELL ALIAS INSTALLER (`larp alias`)
# =============================================================================

# Must stay identical to the marker written by install.sh and removed by
# uninstall.sh, otherwise `larp alias` appends a second copy of the block.
ALIAS_MARKER = "# --- LarpLinux Shortcuts ---"
ALIAS_END_MARKER = "# --- End LarpLinux Shortcuts ---"

SHORTCUTS = [
    ("l", "larp"),
    ("ld", "larp do"),
    ("lw", "larp why"),
    ("lc", "larp chat"),
    ("lg", "larp get"),
    ("lf", "larp fetch"),
]


def detect_user_shell() -> str:
    """Detects the login shell so aliases land in a file the user actually sources."""
    shell_path = os.environ.get("SHELL", "")
    return os.path.basename(shell_path) or "bash"


def cmd_alias():
    """Installs convenient terminal aliases into the config file of the active shell."""
    print_banner()
    shell = detect_user_shell()

    if shell == "fish":
        target = os.path.expanduser("~/.config/fish/config.fish")
        body = "\n".join(f"alias {name}='{command}'" for name, command in SHORTCUTS)
        reload_hint = "exec fish"
    else:
        target = os.path.expanduser(f"~/.{shell}rc" if shell in ("zsh", "bash", "ksh") else "~/.bashrc")
        body = "\n".join(f"alias {name}='{command}'" for name, command in SHORTCUTS)
        reload_hint = f"source {target}"

    try:
        existing = ""
        if os.path.exists(target):
            with open(target, "r", encoding="utf-8", errors="ignore") as f:
                existing = f.read()

        if ALIAS_MARKER in existing:
            print(f"{YELLOW}[!] Larp shortcuts are already present in {target} — nothing to do.{RESET}\n")
            return

        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(target, "a", encoding="utf-8") as f:
            f.write(f"\n{ALIAS_MARKER}\n{body}\n{ALIAS_END_MARKER}\n")

        names = ", ".join(name for name, _ in SHORTCUTS)
        print(f"{GREEN}[+] Short aliases ({names}) successfully added to {target}!{RESET}")
        print(f"{DIM}Run '{reload_hint}' to apply changes.{RESET}\n")
    except Exception as e:
        print(f"{RED}[-] Error adding aliases: {e}{RESET}\n")


# =============================================================================
# AUTONOMOUS SHELL COPILOT (`larp do <task>`)
# =============================================================================

def cmd_do(args: list):
    """Autonomous AI Shell Copilot — translates natural instructions into bash commands."""
    print_banner()
    if not args:
        print(f"{PINK}Larp Autonomous Shell Copilot!{RESET}")
        print(f"{CYAN}Describe the terminal action you want to execute:{RESET}")
        try:
            task = input(" > ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nCancelled.")
            return
    else:
        task = " ".join(args)

    if not task:
        print(f"{YELLOW}[!] Instruction cannot be empty.{RESET}")
        return

    print(f"{CYAN}AI Copilot designing command pipeline for:{RESET} {BOLD}{task}{RESET}...\n")

    prompt = (
        f"The user wants to perform the following terminal task in Linux:\n\"{task}\"\n\n"
        f"Provide a SINGLE safe and exact one-liner bash command pipeline.\n"
        f"Do NOT output any markdown or explanation before/after! Only the one-liner command."
    )

    raw_response = ask_ai_quietly(prompt)
    if not raw_response:
        return

    # Never hand the raw response to the shell: pick one runnable line out of it.
    cmd = extract_single_command(raw_response)

    if not cmd:
        print_box("Larp AI Response", raw_response, border_color=YELLOW)
        print(f"\n{YELLOW}[!] No runnable command could be extracted from the answer — "
              f"nothing will be executed.{RESET}\n")
        return

    print_box("Proposed Terminal Command", f"{BOLD}{WHITE}{cmd}{RESET}", border_color=CYAN)
    print()

    try:
        ans = input(f"{PINK}Execute this command right now? (y/N): {RESET}").strip().lower()
        if ans in ["y", "yes", "yeah"]:
            if not confirm_destructive(cmd):
                return
            print(f"\n{CYAN}Running command...{RESET}\n")
            res = subprocess.run(cmd, shell=True)
            if res.returncode == 0:
                print(f"\n{GREEN}[+] Command executed successfully!{RESET}\n")
            else:
                print(f"\n{RED}[-] Command exited with code {res.returncode}.{RESET}\n")
    except (KeyboardInterrupt, EOFError):
        print("\nCancelled.")


# =============================================================================
# SYSTEM CLEANER & OPTIMIZER (`larp clean`)
# =============================================================================

def cmd_clean():
    """Disk cleanup and system optimization wizard across systemd and non-systemd Linux distros."""
    print_banner()
    print(f"{BOLD}{PINK}Larp System Cleanup & Optimization Wizard:{RESET}\n")

    cleaned_items = []
    pkg_name, _, _, clean_cmd = detect_package_manager()

    if clean_cmd:
        print(f"  {CYAN}Cleaning package manager cache and unneeded packages ({pkg_name})...{RESET}")
        ans = input(f"  {PINK}Clean package cache ({clean_cmd})? (y/N): {RESET}").strip().lower()
        if ans in ["y", "yes", "yeah"]:
            subprocess.run(clean_cmd, shell=True)
            cleaned_items.append(f"{pkg_name} package cache")

    init_name, _, _, _ = detect_init_system()
    if init_name == "systemd":
        print(f"\n  {CYAN}Cleaning old systemd logs (older than 7 days)...{RESET}")
        ans = input(f"  {PINK}Vacuum journalctl logs? (y/N): {RESET}").strip().lower()
        if ans in ["y", "yes", "yeah"]:
            subprocess.run("sudo journalctl --vacuum-time=7d", shell=True)
            cleaned_items.append("Journalctl logs")
    else:
        print(f"\n  {CYAN}Cleaning old rotated log archives in /var/log...{RESET}")
        ans = input(f"  {PINK}Clean rotated log archives? (y/N): {RESET}").strip().lower()
        if ans in ["y", "yes", "yeah"]:
            subprocess.run("sudo rm -f /var/log/*.gz /var/log/*.[0-9] 2>/dev/null || true", shell=True)
            cleaned_items.append("Rotated /var/log archives")

    user_cache = os.path.expanduser("~/.cache")
    if os.path.exists(user_cache):
        print(f"\n  {CYAN}Cleaning user temp cache ({user_cache})...{RESET}")
        ans = input(f"  {PINK}Clear thumbnails and font cache? (y/N): {RESET}").strip().lower()
        if ans in ["y", "yes", "yeah"]:
            subprocess.run("rm -rf ~/.cache/thumbnails/* ~/.cache/fontconfig/* 2>/dev/null", shell=True)
            cleaned_items.append("Thumbnails & font cache")

    print(f"\n{GREEN}[+] Optimization complete! Cleaned: {', '.join(cleaned_items) if cleaned_items else 'system already optimal'}.{RESET}\n")


# =============================================================================
# AI BENCHMARK & SPEEDTEST (`larp bench`)
# =============================================================================

def cmd_bench():
    """Benchmark speed and latency of configured AI providers."""
    print_banner()
    print(f"{BOLD}{PINK}Larp AI Provider Benchmark & Speedtest:{RESET}\n")

    config = load_config()
    test_prompt = "Write three brief sentences highlighting key advantages of Linux."

    providers_to_test = [
        ("Ollama (Local)", "ollama", query_provider_ollama),
        ("Google Gemini API", "gemini", query_provider_gemini),
        ("Anthropic Claude API", "claude", query_provider_claude),
        ("OpenAI API", "openai", query_provider_openai),
        ("OpenRouter", "openrouter", query_provider_openrouter)
    ]

    results = []

    for name, p_id, func in providers_to_test:
        if p_id == "ollama":
            # ensure_ollama_and_get_model() calls sys.exit(1) when the daemon
            # can't be reached, which would abort the whole benchmark before the
            # API providers are ever tried. Skip it instead.
            if not check_ollama_status(config.get("ollama", {}).get("url", OLLAMA_URL)):
                results.append(f"  {GRAY}{name:<24}{RESET} ── {YELLOW}Daemon not running{RESET}")
                continue
        elif not config.get(p_id, {}).get("api_key"):
            results.append(f"  {GRAY}{name:<24}{RESET} ── {YELLOW}API key not configured{RESET}")
            continue

        start_t = time.time()
        try:
            resp = func(test_prompt, "", config)
            elapsed = round(time.time() - start_t, 2)
            words_count = len(resp.split())
            wps = round(words_count / elapsed, 1) if elapsed > 0 else 0
            results.append(f"  {PINK}{BOLD}{name:<24}{RESET} ── {GREEN}{elapsed}s{RESET} ({wps} words/sec, {words_count} words)")
        except ProviderError as e:
            # Providers now raise on failure, so an answer that merely mentions
            # the word "error" is no longer misreported as one.
            reason = plain_text(str(e)).strip().splitlines()[0] if str(e).strip() else "unknown error"
            results.append(f"  {PINK}{name:<24}{RESET} ── {RED}{reason[:48]}{RESET}")
        except Exception as e:
            results.append(f"  {PINK}{name:<24}{RESET} ── {RED}Failed ({e}){RESET}")

    print_box("AI Provider Speedtest Results", "\n".join(results), border_color=CYAN)
    print()


# =============================================================================
# QUERY & CONVERSATION HISTORY (`larp history`)
# =============================================================================

def cmd_history():
    """Displays prompt history and AI responses."""
    print_banner()
    if not os.path.exists(HISTORY_FILE):
        print(f"{LIGHT_PINK}Query history is empty.{RESET}\n")
        return

    try:
        with open(HISTORY_FILE, "r", encoding="utf-8") as f:
            history = json.load(f)
    except Exception:
        print(f"{RED}Error reading history file.{RESET}\n")
        return

    if not history:
        print(f"{LIGHT_PINK}Query history is empty.{RESET}\n")
        return

    print(f"{BOLD}{PINK}Recent {len(history)} Larp AI Queries:{RESET}\n")
    lines = []
    for idx, item in enumerate(reversed(history[:15]), 1):
        ts = item.get("timestamp", "")
        prov = item.get("provider", "").upper()
        q = item.get("query", "")
        lines.append(f" {PINK}{idx:2d}.{RESET} [{CYAN}{ts}{RESET}] ({BOLD}{prov}{RESET}) {BOLD}{q}{RESET}")

    print("\n".join(lines))
    print(f"\n{DIM}History log path: {HISTORY_FILE}{RESET}\n")


# =============================================================================
# INTERACTIVE CONFIG MENU (TUI)
# =============================================================================

def offer_to_activate(config: dict, provider_id: str, label: str) -> None:
    """Offers to make a freshly configured provider the active one.

    Configuring a provider and selecting it are separate menu entries, so it is
    easy to enter a key, leave the menu, and have requests still go to the
    previously active provider.
    """
    if config.get("provider") == provider_id:
        return
    if not config.get(provider_id, {}).get("api_key", "").strip():
        return

    current = config.get("provider", "ollama").upper()
    print(f"\n{CYAN}Active provider is currently {BOLD}{current}{RESET}{CYAN}.{RESET}")
    try:
        ans = input(f"{PINK}Make {label} the active provider? (Y/n): {RESET}").strip().lower()
    except (KeyboardInterrupt, EOFError):
        print()
        return

    if ans in ["", "y", "yes", "yeah", "д", "да"]:
        config["provider"] = provider_id
        save_config(config)
        print(f"{GREEN}[+] {label} is now the active provider.{RESET}")
    else:
        print(f"{DIM}Keeping {current} active. Switch later with option 1, "
              f"or: larp config set provider {provider_id}{RESET}")


def interactive_config_menu():
    """Interactive step-by-step TUI settings menu."""
    while True:
        config = load_config()
        curr_p = config.get("provider", "ollama").upper()

        conf_lines = [
            f"  {CYAN}Active AI Provider:{RESET}     {BOLD}{PINK}{curr_p}{RESET}",
            f"  {CYAN}Web Search (DuckDuckGo):{RESET} {'Enabled' if config.get('web_search', True) else 'Disabled'}",
            f"  {CYAN}Auto-Repair (No Prompt):{RESET} {'Enabled (Instant Fix)' if config.get('auto_fix', False) else 'Disabled (Ask y/N)'}\n",
            f"  {BOLD}{PINK}1.{RESET} Switch Active AI Provider (Ollama / Gemini / Claude / OpenAI / OpenRouter)",
            f"  {BOLD}{PINK}2.{RESET} Configure Google Gemini API",
            f"  {BOLD}{PINK}3.{RESET} Configure Anthropic Claude API",
            f"  {BOLD}{PINK}4.{RESET} Configure OpenAI API",
            f"  {BOLD}{PINK}5.{RESET} Configure OpenRouter (one key, ~400 models)",
            f"  {BOLD}{PINK}6.{RESET} Configure Ollama (Model / URL)",
            f"  {BOLD}{PINK}7.{RESET} Toggle Web Search (On/Off)",
            f"  {BOLD}{PINK}8.{RESET} Toggle Auto-Repair Mode (On/Off)",
            f"  {BOLD}{PINK}9.{RESET} Reset Configuration to Defaults",
            f"  {BOLD}{PINK}0.{RESET} Save & Exit"
        ]

        print_banner()
        print_box("Larp AI Interactive Config Menu", "\n".join(conf_lines), border_color=PINK)
        print()

        try:
            choice = input(f"{PINK}{BOLD}Select an option [0-9]: {RESET}").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nExiting configuration.")
            break

        if choice == "0":
            print(f"\n{GREEN}[+] Configuration saved. Great job!{RESET}\n")
            break

        elif choice == "1":
            print(f"\n{CYAN}Select active AI Provider:{RESET}")
            print(f"  1) {PINK}Ollama{RESET} (Local Neural Network)")
            print(f"  2) {PINK}Google Gemini API{RESET}")
            print(f"  3) {PINK}Anthropic Claude API{RESET}")
            print(f"  4) {PINK}OpenAI (ChatGPT) API{RESET}")
            print(f"  5) {PINK}OpenRouter{RESET} (one key for Claude / Gemini / GPT / Llama ...)")
            p_ans = input("Your choice [1-5]: ").strip()
            p_map = {"1": "ollama", "2": "gemini", "3": "claude", "4": "openai", "5": "openrouter"}
            if p_ans in p_map:
                config["provider"] = p_map[p_ans]
                save_config(config)

        elif choice == "2":
            print(f"\n{CYAN}─── Configure Google Gemini API ───{RESET}")
            key = input(f"Enter Gemini API Key (Enter to keep current): ").strip()
            if key:
                config["gemini"]["api_key"] = key
            model = input(f"Gemini Model [{config['gemini']['model']} / 'auto']: ").strip()
            if model:
                config["gemini"]["model"] = model
            save_config(config)
            offer_to_activate(config, "gemini", "Google Gemini")

        elif choice == "3":
            print(f"\n{CYAN}─── Configure Anthropic Claude API ───{RESET}")
            key = input(f"Enter Claude API Key (Enter to keep current): ").strip()
            if key:
                config["claude"]["api_key"] = key
            model = input(f"Claude Model [{config['claude']['model']}]: ").strip()
            if model:
                config["claude"]["model"] = model
            save_config(config)
            offer_to_activate(config, "claude", "Anthropic Claude")

        elif choice == "4":
            print(f"\n{CYAN}─── Configure OpenAI API ───{RESET}")
            key = input(f"Enter OpenAI API Key (Enter to keep current): ").strip()
            if key:
                config["openai"]["api_key"] = key
            model = input(f"OpenAI Model [{config['openai']['model']}]: ").strip()
            if model:
                config["openai"]["model"] = model
            save_config(config)
            offer_to_activate(config, "openai", "OpenAI")

        elif choice == "5":
            print(f"\n{CYAN}─── Configure OpenRouter ───{RESET}")
            print(f"{DIM}One API key for Claude, Gemini, GPT, Llama and ~400 other models.{RESET}")
            print(f"{DIM}Get a key at https://openrouter.ai/keys{RESET}")
            key = input(f"Enter OpenRouter API Key (Enter to keep current): ").strip()
            if key:
                config["openrouter"]["api_key"] = key
            print(f"{DIM}Model IDs are namespaced, e.g. anthropic/claude-sonnet-5, google/gemini-2.5-flash.{RESET}")
            print(f"{DIM}Run 'larp config models' to browse the full list.{RESET}")
            model = input(f"OpenRouter Model [{config['openrouter']['model']}]: ").strip()
            if model:
                config["openrouter"]["model"] = model
            save_config(config)
            offer_to_activate(config, "openrouter", "OpenRouter")

        elif choice == "6":
            print(f"\n{CYAN}─── Configure Ollama ───{RESET}")
            url = input(f"Ollama URL [{config['ollama']['url']}]: ").strip()
            if url:
                config["ollama"]["url"] = url
            model = input(f"Ollama Model [{config['ollama']['model']}]: ").strip()
            if model:
                config["ollama"]["model"] = model
            save_config(config)

        elif choice == "7":
            config["web_search"] = not config.get("web_search", True)
            save_config(config)
            print(f"{GREEN}Web Search toggled to: {config['web_search']}{RESET}")

        elif choice == "8":
            config["auto_fix"] = not config.get("auto_fix", False)
            save_config(config)
            print(f"{GREEN}Auto-Repair toggled to: {config['auto_fix']}{RESET}")

        elif choice == "9":
            save_config(json.loads(json.dumps(DEFAULT_CONFIG)))
            print(f"{GREEN}Configuration reset to default settings!{RESET}")

        time.sleep(0.5)


def show_fallback_chain(config: dict):
    """Prints the order providers are tried in, active provider first."""
    attempts = build_attempt_chain(config)
    first = describe_attempt(attempts[0][0], attempts[0][1], config)
    lines = [f"  {GREEN}1.{RESET} {BOLD}{first}{RESET} {DIM}(active provider){RESET}"]
    for position, (provider, model) in enumerate(attempts[1:], start=2):
        lines.append(f"  {CYAN}{position}.{RESET} {describe_attempt(provider, model, config)}")

    if len(attempts) == 1:
        lines.append(f"\n  {DIM}No fallbacks configured — a failure is reported instead of retried.{RESET}")
        lines.append(f"  {DIM}Add one: larp fallback add openrouter anthropic/claude-sonnet-5{RESET}")

    print_box("Provider Order", "\n".join(lines), border_color=CYAN)
    print()


def cmd_fallback(args: list):
    """Manages the provider fallback chain."""
    print_banner()
    config = load_config()
    action = args[0].lower() if args else "show"

    if action in ["show", "list", "status"]:
        show_fallback_chain(config)
        return

    if action == "add":
        if len(args) < 2:
            print(f"{YELLOW}[!] Usage: larp fallback add <provider> [model]{RESET}")
            print(f"{DIM}    Providers: {', '.join(sorted(PROVIDER_FUNCS))}{RESET}\n")
            return
        provider = args[1].lower()
        if provider not in PROVIDER_FUNCS:
            print(f"{RED}[-] Unknown provider '{provider}'. Valid: {', '.join(sorted(PROVIDER_FUNCS))}{RESET}\n")
            return
        model = args[2].strip() if len(args) > 2 else ""

        chain = list(config.get("fallback_chain", []) or [])
        entry = {"provider": provider}
        if model:
            entry["model"] = model
        if entry in chain:
            print(f"{YELLOW}[!] {describe_attempt(provider, model)} is already in the chain.{RESET}\n")
            return
        chain.append(entry)
        config["fallback_chain"] = chain
        save_config(config)
        print(f"{GREEN}[+] Added {describe_attempt(provider, model)} to the fallback chain.{RESET}\n")
        show_fallback_chain(config)
        return

    if action in ["remove", "rm", "del"]:
        chain = list(config.get("fallback_chain", []) or [])
        if not chain:
            print(f"{YELLOW}[!] The fallback chain is already empty.{RESET}\n")
            return
        if len(args) < 2:
            print(f"{YELLOW}[!] Usage: larp fallback remove <number>{RESET}")
            show_fallback_chain(config)
            return
        try:
            # Numbering matches `larp fallback show`, where 1 is the active
            # provider and the chain starts at 2.
            position = int(args[1])
        except ValueError:
            print(f"{RED}[-] Expected a number from the list, got '{args[1]}'.{RESET}\n")
            return
        index = position - 2
        if index < 0 or index >= len(chain):
            print(f"{RED}[-] No fallback entry number {position}. "
                  f"Entry 1 is the active provider — change it with 'larp config set provider'.{RESET}\n")
            return
        removed = chain.pop(index)
        config["fallback_chain"] = chain
        save_config(config)
        print(f"{GREEN}[+] Removed {describe_attempt(removed.get('provider', ''), removed.get('model', ''))}.{RESET}\n")
        show_fallback_chain(config)
        return

    if action == "clear":
        config["fallback_chain"] = []
        save_config(config)
        print(f"{GREEN}[+] Fallback chain cleared. Failures will be reported, not retried.{RESET}\n")
        return

    print(f"{YELLOW}[!] Unknown action '{action}'.{RESET}")
    print(f"{CYAN}Usage:{RESET} larp fallback [show | add <provider> [model] | remove <number> | clear]\n")


def cmd_config_models(args: list, config: dict):
    """Lists OpenRouter model IDs, optionally filtered by a substring."""
    print_banner()
    query = " ".join(args).strip().lower()

    print(f"{CYAN}Fetching model list from OpenRouter...{RESET}")
    models = get_openrouter_models(config.get("openrouter", {}).get("api_key", "").strip())

    if not models:
        print(f"{RED}[-] Could not fetch the model list. Check your internet connection.{RESET}\n")
        return

    if query:
        models = [m for m in models if query in m.lower()]
        if not models:
            print(f"{YELLOW}[!] No models matching '{query}'.{RESET}\n")
            return

    current = config.get("openrouter", {}).get("model", "")
    lines = []
    for model_id in models:
        marker = f"{GREEN}*{RESET}" if model_id == current else " "
        lines.append(f" {marker} {model_id}")

    title = f"OpenRouter Models ({len(models)})" + (f" matching '{query}'" if query else "")
    print_box(title, "\n".join(lines), border_color=CYAN)
    print(f"\n{DIM}Filter with: larp config models <text>   |   Select with: larp config set openrouter.model <id>{RESET}\n")


def coerce_config_value(raw: str, current):
    """Converts a command-line string to the type the setting already holds.

    `larp config set` writes straight into config.json, which is sent to the
    provider APIs as-is — a boolean stored as the string "true" or a timeout
    stored as "5" is rejected on the wire, far away from the typo.
    """
    if isinstance(current, bool):
        return raw.strip().lower() in ["true", "1", "yes", "on", "y"]
    if isinstance(current, int):
        try:
            return int(raw)
        except ValueError:
            return raw
    if isinstance(current, float):
        try:
            return float(raw)
        except ValueError:
            return raw
    return raw


def cmd_config(args: list):
    if not args:
        interactive_config_menu()
        return

    subcmd = args[0].lower()
    config = load_config()

    if subcmd in ["show", "get", "list"]:
        interactive_config_menu()
    elif subcmd == "models":
        cmd_config_models(args[1:], config)
    elif subcmd == "set" and len(args) >= 3:
        key_path = args[1].lower()
        val = args[2]

        keys = key_path.split(".")
        if len(keys) == 1:
            if keys[0] == "provider":
                if val.lower() not in PROVIDER_FUNCS:
                    print(f"{RED}[-] Valid providers: {', '.join(sorted(PROVIDER_FUNCS))}{RESET}")
                    return
                config["provider"] = val.lower()
            elif keys[0] in ["web_search", "auto_fix"]:
                config[keys[0]] = coerce_config_value(val, True)
            else:
                # Creating arbitrary top-level keys only ever produced silent
                # typos that looked like they had been applied.
                print(f"{RED}[-] Unknown setting: {keys[0]}{RESET}")
                print(f"{CYAN}Top-level settings: provider, web_search, auto_fix{RESET}")
                print(f"{CYAN}Section settings:   {'.'.join(['<section>', '<key>'])} "
                      f"(sections: {', '.join(sorted(PROVIDER_FUNCS))}){RESET}")
                return
        elif len(keys) == 2:
            section, item = keys[0], keys[1]
            if section not in config or not isinstance(config[section], dict):
                print(f"{RED}[-] Unknown config section: {section}{RESET}")
                return
            if item not in config[section]:
                print(f"{YELLOW}[!] '{section}' has no setting '{item}'. "
                      f"Known: {', '.join(sorted(config[section]))}{RESET}")
                return
            # The stored default tells us the type the API expects: without this
            # `ollama.keep_alive 5` was saved as the string "5" and rejected.
            config[section][item] = coerce_config_value(val, config[section][item])
        else:
            print(f"{RED}[-] Expected <key> or <section>.<key>, got '{key_path}'.{RESET}")
            return

        save_config(config)

    elif subcmd == "reset":
        save_config(json.loads(json.dumps(DEFAULT_CONFIG)))
        print(f"{GREEN}[+] Settings reset to defaults!{RESET}")
    else:
        interactive_config_menu()


def make_bar(percent: float, length: int = 20) -> str:
    filled = int(round(length * percent / 100))
    bar = "█" * filled + "░" * (length - filled)
    return f"{PINK}{bar}{RESET} {percent:.1f}%"


def cmd_status():
    print_banner()
    print(f"{BOLD}{PINK}Larp System Radar & Hardware Diagnostics:{RESET}\n")
    config = load_config()

    sys_info = []

    try:
        load = os.getloadavg()[0]
        cores = os.cpu_count() or 1
        cpu_pct = min(100.0, round((load / cores) * 100, 1))
        sys_info.append(f"  {CYAN}CPU Usage:{RESET}      [{make_bar(cpu_pct)}] (Load: {load})")
    except Exception:
        pass

    total, avail = read_meminfo()
    if total:
        used = total - avail
        ram_pct = round((used / total) * 100, 1)
        sys_info.append(f"  {CYAN}RAM Usage:{RESET}      [{make_bar(ram_pct)}] "
                        f"({round(used/1048576, 1)}GB / {round(total/1048576, 1)}GB)")

    try:
        st = os.statvfs("/")
        total_disk = st.f_blocks * st.f_frsize
        free_disk = st.f_bavail * st.f_frsize
        used_disk = total_disk - free_disk
        disk_pct = round((used_disk / total_disk) * 100, 1)
        sys_info.append(f"  {CYAN}Disk Usage (/):{RESET} [{make_bar(disk_pct)}] ({round(used_disk/1073741824, 1)}GB / {round(total_disk/1073741824, 1)}GB)")
    except Exception:
        pass

    wm_info = os.environ.get("XDG_CURRENT_DESKTOP", "Wayland")
    sys_info.append(f"  {CYAN}Compositor:{RESET}     {PINK}{wm_info}{RESET}")

    current_provider = config.get("provider", "ollama").upper()
    sys_info.append(f"  {CYAN}Active AI:{RESET}      {BOLD}{PINK}{current_provider}{RESET}")

    if current_provider == "OLLAMA":
        ollama_ok = check_ollama_status(config['ollama']['url'])
        ollama_status = f"{GREEN}● Active{RESET}" if ollama_ok else f"{GRAY}○ Stopped (VRAM Freed){RESET}"
        sys_info.append(f"  {CYAN}Ollama Daemon:{RESET}  {ollama_status}")
        if ollama_ok:
            models = get_available_ollama_models(config['ollama']['url'])
            model_str = ", ".join(models) if models else "none"
            sys_info.append(f"  {CYAN}AI Models:{RESET}      {LIGHT_PINK}{model_str}{RESET}")

    print_box("Larp System Radar", "\n".join(sys_info), border_color=CYAN)
    print()


def cmd_monitor():
    """Live interactive real-time system resource monitor."""
    print("\033[2J\033[H", end="")
    try:
        while True:
            sys.stdout.write("\033[H")
            cmd_status()
            print(f"{DIM}Press Ctrl+C to exit monitor...{RESET}")
            time.sleep(2)
    except KeyboardInterrupt:
        print(f"\n{CYAN}Exiting monitor.{RESET}\n")


def cmd_chat():
    print_banner()
    config = load_config()
    provider_name = config.get("provider", "ollama").upper()
    print_box("Larp AI Interactive Session", f"{PINK}Interactive Larp AI Session ({provider_name})!{RESET}\n{DIM}Type 'exit' or 'quit' to leave session.{RESET}")
    print()

    history = []

    while True:
        try:
            user_input = input(f"{PINK}{BOLD}You > {RESET}").strip()
        except (KeyboardInterrupt, EOFError):
            print(f"\n{CYAN}Goodbye!{RESET}")
            break

        if not user_input:
            continue

        if user_input.lower() in ["exit", "quit"]:
            print(f"{CYAN}Goodbye!{RESET}")
            break

        # Exact commands only, never a substring of a sentence: "как исправить
        # конфиг" is a question about a config file, not a request to run sudo
        # against the system.
        fix_commands = {
            "/fix", "fix", "repair", "fix my system", "fix system", "fix errors",
            "repair errors", "почини", "починить", "почини систему",
            "исправь", "исправить", "отремонтируй", "фикс",
        }

        if user_input.strip().lower().rstrip("!.?") in fix_commands:
            print(f"\n{CYAN}[Larp Auto-Repair Engine]{RESET} {PINK}Scanning system logs...{RESET}\n")
            repaired = cmd_fix()
            history.append(f"User: {user_input}")
            outcome = "applied the proposed repair command" if repaired else "no repair command was executed"
            history.append(f"Larp AI: [Ran system log diagnostics; {outcome}]")
            continue

        history.append(f"User: {user_input}")

        web_ctx = get_full_web_context(user_input)

        if any(kw in user_input.lower() for kw in ["error", "issue", "problem", "journalctl", "log", "ошибк", "проблем", "лог"]):
            try:
                if shutil.which("journalctl"):
                    res = subprocess.run(["journalctl", "-p", "3", "-n", "15", "--no-pager"], capture_output=True, text=True, check=False)
                    logs_ctx = res.stdout.strip()
                else:
                    res = subprocess.run("dmesg -T -l err,crit,alert,emerg 2>/dev/null | tail -n 15", shell=True, capture_output=True, text=True, check=False)
                    logs_ctx = res.stdout.strip()

                if logs_ctx:
                    web_ctx += f"\n\n[LIVE CRITICAL SYSTEM LOGS]:\n{logs_ctx}"
            except Exception:
                pass

        prompt_with_history = "\n".join(history[-6:])

        response = ask_ai_streamed(f"Larp AI ({provider_name})", prompt_with_history,
                                   extra_web_context=web_ctx)
        if response:
            history.append(f"Larp AI: {response}")
        else:
            # Drop the unanswered turn so the next prompt is not sent with a
            # dangling user message and no reply.
            history.pop()
        print()


