def plain_text(text: str) -> str:
    """Strips ANSI colour codes — useful when a coloured message is reused inside another."""
    return re.sub(r'\x1b\[[0-9;]*m', '', text)


class ProviderError(Exception):
    """A provider could not answer.

    Providers raise this instead of returning an error string, so a failure is a
    distinct control-flow signal. The previous convention — returning a coloured
    string and testing `"Error" in response` — cannot tell a failure apart from a
    perfectly good answer that happens to discuss an error message, which is a
    common thing to ask a Linux assistant about.
    """


class Spinner:
    """Animated Braille console spinner."""
    def __init__(self, message="Loading..."):
        self.message = message
        self.running = False
        self.thread = None
        self.frames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]

    def _spin(self):
        idx = 0
        while self.running:
            frame = self.frames[idx % len(self.frames)]
            sys.stdout.write(f"\r{PINK}{frame}{RESET} {CYAN}{self.message}{RESET}")
            sys.stdout.flush()
            time.sleep(0.08)
            idx += 1
        sys.stdout.write(f"\r{' ' * (len(self.message) + 12)}\r")
        sys.stdout.flush()

    def start(self):
        self.running = True
        self.thread = threading.Thread(target=self._spin)
        self.thread.daemon = True
        self.thread.start()

    def stop(self):
        """Idempotent: streaming providers stop the spinner on the first token,
        and the surrounding error handling may stop it again."""
        if not self.thread:
            return
        self.running = False
        if self.thread.is_alive():
            self.thread.join()
        self.thread = None


class AudioVisualizer:
    """Console TUI Oscilloscope audio visualizer banner with real-time level meter."""
    def __init__(self, title="Listening to microphone..."):
        self.title = title
        self.running = False
        self.thread = None
        self.level = 0.0
        self.status = "RECORDING"

    def set_level(self, rms_val: float):
        self.level = min(1.0, max(0.0, rms_val / 1800.0))

    def update(self, title: str = None, status: str = None, level: float = None):
        if title is not None: self.title = title
        if status is not None: self.status = status
        if level is not None: self.set_level(level)

    def _visualize(self):
        wave_chars = [" ", " ", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
        step = 0
        while self.running:
            step += 1
            num_bars = 14
            max_idx = int(self.level * (len(wave_chars) - 1))
            bar_list = []
            for i in range(num_bars):
                var = math.sin(step * 0.4 + i * 0.5) * 0.3 + 0.7
                idx = max(0, min(len(wave_chars) - 1, int(max_idx * var)))
                if self.level < 0.04:
                    idx = 0 if (i + step) % 5 != 0 else 1
                bar_list.append(wave_chars[idx])
            
            meter = "".join(bar_list)
            icon = "🎙️" if "RECORD" in self.status else "⚡" if "TRANSCRIB" in self.status else "🔊"
            sys.stdout.write(f"\r{PINK}  {icon} [{CYAN}{meter}{PINK}] {BOLD}{self.title}{RESET} {DIM}(Ctrl+C to stop){RESET}   ")
            sys.stdout.flush()
            time.sleep(0.08)
        
        sys.stdout.write(f"\r{' ' * 75}\r")
        sys.stdout.flush()

    def start(self):
        self.running = True
        self.thread = threading.Thread(target=self._visualize)
        self.thread.daemon = True
        self.thread.start()

    def stop(self):
        self.running = False
        if self.thread:
            self.thread.join()
        self.thread = None


class StreamPrinter:
    """Prints a model answer token by token, wrapped to the terminal width.

    A spinner only says "something is happening"; this shows the answer being
    written, which is the difference between waiting blind for 40 seconds and
    reading along. Wrapping is done here because the text arrives in fragments
    that do not respect word or line boundaries.
    """

    def __init__(self, title: str, border_color: str = PINK):
        self.title = title
        self.border_color = border_color
        self.width = box_width()
        self.column = 0
        self.pending = ""
        self.started = False
        self.chunks = []
        # Leading spaces are kept after a real newline (indented code lines keep
        # their shape) but dropped after a soft wrap, where they would look like
        # a ragged left margin.
        self.after_hard_newline = True

    def _open(self):
        dashes = max(0, self.width - visible_width(self.title) - 4)
        print(f"{self.border_color}╭─ {BOLD}{WHITE}{self.title}{RESET} "
              f"{self.border_color}{'─' * dashes}╮{RESET}")
        sys.stdout.write(f"{self.border_color}│{RESET} ")
        sys.stdout.flush()
        self.started = True

    def _newline(self, hard: bool = True):
        sys.stdout.write(f"\n{self.border_color}│{RESET} ")
        self.column = 0
        self.after_hard_newline = hard

    def _emit_word(self, word: str):
        if self.column + len(word) > self.width - 2 and self.column > 0:
            self._newline(hard=False)
        sys.stdout.write(word)
        self.column += len(word)
        self.after_hard_newline = False

    def write(self, chunk: str):
        """Feeds one fragment of the answer to the terminal."""
        if not chunk:
            return
        if not self.started:
            self._open()
        self.chunks.append(chunk)

        # Buffer until a word boundary so a word is never split across a wrap.
        self.pending += chunk
        while True:
            match = re.search(r'[\s\n]', self.pending)
            if not match:
                break
            word, separator, self.pending = (
                self.pending[:match.start()],
                self.pending[match.start()],
                self.pending[match.start() + 1:],
            )
            if word:
                self._emit_word(word)
            if separator == "\n":
                self._newline()
            elif self.column > 0 or self.after_hard_newline:
                sys.stdout.write(" ")
                self.column += 1
        sys.stdout.flush()

    def finish(self) -> str:
        """Closes the box and returns everything that was printed."""
        if not self.started:
            return "".join(self.chunks)
        if self.pending:
            self._emit_word(self.pending)
            self.pending = ""
        print(f"\n{self.border_color}╰" + "─" * max(0, self.width - 2) + f"╯{RESET}")
        sys.stdout.flush()
        return "".join(self.chunks)


def print_banner():
    banner = f"""
{PINK}{BOLD}  ╭───╮   {DEEP_PINK} █░░ █▀█ █▀█ █▀█ █░░ ░▀█ █▄░█ █░█ █░█{RESET}
{PINK}{BOLD}  │   │   {DEEP_PINK} █▄▄ █▀█ █▀▄ █▀▀ █▄▄ █▄█ █░▀█ █▄█ ▄▀▄{RESET}
{PINK}{BOLD}  ╰───╯   {CYAN}─── Universal AI OS Companion v{__version__} ───{RESET}
"""
    print(banner)


def visible_width(text: str) -> int:
    """Length of `text` as rendered — colour escapes occupy no columns."""
    return len(plain_text(text))


def box_width() -> int:
    """Inner width shared by print_box() and the streaming printer."""
    return max(20, min(shutil.get_terminal_size((80, 20)).columns - 4, 90))


def wrap_to_width(text: str, width: int) -> list:
    """Wraps text to `width` visible columns, preserving blank lines and indentation.

    Model answers routinely exceed the terminal width; without this the box
    borders wrapped mid-line and the output looked broken.
    """
    wrapped = []
    for line in text.splitlines() or [""]:
        if visible_width(line) <= width:
            wrapped.append(line)
            continue
        if plain_text(line).strip() == "":
            wrapped.append("")
            continue
        indent = line[:len(line) - len(line.lstrip())]
        # textwrap counts escape sequences as characters, so only uncoloured
        # lines can be wrapped precisely; coloured ones are left intact rather
        # than cut in the middle of an escape.
        if "\x1b" in line:
            wrapped.append(line)
            continue
        wrapped.extend(textwrap.wrap(
            line, width=width, initial_indent=indent, subsequent_indent=indent,
            break_long_words=True, break_on_hyphens=False,
        ) or [""])
    return wrapped


def print_box(title: str, text: str, border_color: str = PINK):
    term_width = box_width()
    inner_width = term_width - 2

    dashes = max(0, term_width - visible_width(title) - 4)
    top = f"{border_color}╭─ {BOLD}{WHITE}{title}{RESET} " + f"{border_color}{'─' * dashes}╮{RESET}"
    bottom = f"{border_color}╰" + "─" * max(0, term_width - 2) + f"╯{RESET}"

    print(top)
    for line in wrap_to_width(text, inner_width):
        print(f"{border_color}│{RESET} {line}")
    print(bottom)


def detect_package_manager() -> tuple:
    """Dynamically detects active package manager across any Linux distribution."""
    if shutil.which("pacman"):
        return ("pacman", "sudo pacman -S --needed", "sudo pacman -Syu", "sudo pacman -Sc --noconfirm")
    elif shutil.which("apt"):
        return ("apt", "sudo apt install -y", "sudo apt update && sudo apt upgrade -y", "sudo apt autoremove -y && sudo apt clean")
    elif shutil.which("dnf"):
        return ("dnf", "sudo dnf install -y", "sudo dnf upgrade -y", "sudo dnf autoremove -y && sudo dnf clean all")
    elif shutil.which("zypper"):
        return ("zypper", "sudo zypper install -y", "sudo zypper update -y", "sudo zypper clean --all")
    elif shutil.which("apk"):
        return ("apk", "sudo apk add", "sudo apk update && sudo apk upgrade", "sudo apk cache clean")
    elif shutil.which("xbps-install"):
        return ("xbps", "sudo xbps-install -Sy", "sudo xbps-install -Su", "sudo xbps-remove -O")
    elif shutil.which("eopkg"):
        return ("eopkg", "sudo eopkg it -y", "sudo eopkg ur && sudo eopkg up -y", "sudo eopkg rmo")
    elif shutil.which("emerge"):
        return ("emerge", "sudo emerge -av", "sudo emerge --sync && sudo emerge -uDN @world", "sudo emerge --depclean")
    return ("package-manager", "sudo install", "sudo update", "sudo clean")


def detect_init_system() -> tuple:
    """Detects active init system (systemd, OpenRC, runit, dinit, s6, sysvinit)."""
    if shutil.which("systemctl") and os.path.exists("/run/systemd/system"):
        return ("systemd", "sudo systemctl start", "sudo systemctl restart", "sudo systemctl stop")
    elif shutil.which("rc-service"):
        return ("OpenRC", "sudo rc-service start", "sudo rc-service restart", "sudo rc-service stop")
    elif shutil.which("sv"):
        return ("runit", "sudo sv start", "sudo sv restart", "sudo sv stop")
    elif shutil.which("dinitctl"):
        return ("dinit", "sudo dinitctl start", "sudo dinitctl restart", "sudo dinitctl stop")
    elif shutil.which("service"):
        return ("sysvinit", "sudo service start", "sudo service restart", "sudo service stop")
    return ("init-system", "sudo service start", "sudo service restart", "sudo service stop")


def build_system_prompt() -> str:
    """Cute 'nyashka' Linux AI persona tailored dynamically to any Linux distribution and init system."""
    os_name = "Linux"
    if os.path.exists("/etc/os-release"):
        try:
            with open("/etc/os-release", "r") as f:
                for line in f:
                    if line.startswith("PRETTY_NAME="):
                        os_name = line.split("=")[1].strip().strip('"')
                        break
        except Exception:
            pass

    pkg_name, install_cmd, _, _ = detect_package_manager()
    init_name, service_cmd, _, _ = detect_init_system()

    return (
        f"You are Larp AI, a super cute, warm, friendly, and enthusiastic AI companion for {os_name}!" "\n\n"
        r"PERSONALITY & BEHAVIOR:" "\n"
        r"1. Be adorable, friendly, warm, and helpful (a true cute companion / няшка)! Never be a boring, stiff, or robotic 'dushnila'." "\n"
        r"2. TERMINAL FONT & KAOMOJI RULE: NEVER use graphic emojis OR rare CJK Unicode symbols that result in broken boxes or missing characters in terminal fonts! ONLY use safe 100% standard ASCII kaomoji that render cleanly in any Linux console (such as (^_^), (^--^), (o_O), (x_x), (=^.^=), \(^o^)/, (>-<), (¬_¬), (-_-;))." "\n"
        f"3. SYSTEM CONTEXT: OS: {os_name} | Package Manager: {pkg_name} | Init System: {init_name} (service command: '{service_cmd}')." "\n"
        r"4. Do NOT mention any desktop environments, window managers, or personal user details unless the user explicitly asks about them." "\n"
        f"5. Provide accurate, safe, and verified Linux commands tailored specifically for {os_name}, {pkg_name}, and {init_name}." "\n"
        r"6. NEVER suggest Windows-specific tools or concepts (no sfc, chkdsk, bsod)." "\n"
        r"7. ALWAYS respond in the EXACT SAME LANGUAGE as the user's message (e.g., reply in Russian if asked in Russian)."
    )


DESTRUCTIVE_PATTERNS = [
    (r'\brm\s+(-[a-zA-Z]*\s+)*-?[a-zA-Z]*[rf][a-zA-Z]*\s+/(\s|$)', "recursive delete of /"),
    (r'\brm\s+(-[a-zA-Z]*\s+)*/\*', "delete of /*"),
    (r'\bmkfs(\.[a-z0-9]+)?\b', "filesystem format (mkfs)"),
    (r'\bdd\b[^|;&]*\bof=/dev/', "raw write to a block device (dd)"),
    (r'>\s*/dev/(sd|nvme|hd|vd)', "redirect onto a block device"),
    (r'\b(wipefs|shred)\b[^|;&]*/dev/', "wiping a block device"),
    (r'\bchmod\s+(-[a-zA-Z]+\s+)*777\s+/(\s|$)', "chmod 777 on /"),
    (r'\bchown\b[^|;&]*\s+/(\s|$)', "recursive chown of /"),
    (r':\(\)\s*\{.*\}\s*;?\s*:', "fork bomb"),
    (r'>\s*/etc/(passwd|shadow|fstab)', "overwrite of a critical system file"),
]


def find_destructive_pattern(cmd: str):
    """Returns a human-readable reason if the command matches a known destructive pattern."""
    if not cmd:
        return None
    for pattern, reason in DESTRUCTIVE_PATTERNS:
        if re.search(pattern, cmd):
            return reason
    return None


def confirm_destructive(cmd: str) -> bool:
    """Requires an explicit typed confirmation before running a destructive command."""
    reason = find_destructive_pattern(cmd)
    if not reason:
        return True

    print(f"\n{RED}{BOLD}[!] DANGER: this command looks destructive — {reason}.{RESET}")
    print(f"{RED}    It was generated by an AI model and may be wrong or irreversible.{RESET}")
    print(f"{YELLOW}    Read it carefully:{RESET} {BOLD}{cmd}{RESET}\n")
    try:
        answer = input(f"{RED}Type {BOLD}I UNDERSTAND{RESET}{RED} to run it anyway, anything else to cancel: {RESET}").strip()
    except (KeyboardInterrupt, EOFError):
        print("\nCancelled.")
        return False

    if answer == "I UNDERSTAND":
        return True
    print(f"{GREEN}[+] Cancelled — nothing was executed.{RESET}\n")
    return False


def sanitize_shell_command(cmd: str) -> str:
    """Cleans an AI-generated command, or returns "" if it cannot be trusted.

    Unbalanced quotes used to be "fixed" by appending the missing quote. That
    silently changes what the command does before it is handed to a shell, so a
    truncated or malformed command is now rejected outright: the caller reports
    it instead of running a guess.
    """
    if not cmd:
        return ""
    cmd = cmd.strip()
    cmd = re.sub(r'^`+|`+$', '', cmd).strip()
    cmd = re.sub(r'^bash\s+', '', cmd).strip()

    if cmd.count("'") % 2 != 0 or cmd.count('"') % 2 != 0:
        return ""

    return cmd.strip()


# Shell keywords and builtins that legitimately start a one-liner but are not
# files on disk, so shutil.which() cannot see them.
SHELL_BUILTINS = {
    "cd", "echo", "export", "for", "while", "if", "case", "read", "set",
    "unset", "source", "test", "printf", "eval", "exec", "true", "false",
    "sudo", "doas", "time", "env", "command",
}


def looks_like_a_command(line: str) -> bool:
    """True when the line starts with something this machine can actually run.

    Checking the first token against PATH is what separates a command from
    prose: a sentence like "Then remove the cache" starts with a word that is
    not an executable, while `find / -name '*.log'` starts with one that is.
    """
    stripped = line.strip()
    if not stripped or stripped.startswith("#") or stripped.startswith("[-]") or stripped.startswith("[+]"):
        return False
    if " — " in stripped or " -- " in stripped or "Connection refused" in stripped or "failed:" in stripped.lower():
        return False

    first = stripped.split()[0]
    # Variable assignments and absolute paths are commands too.
    if re.match(r'^[A-Za-z_][A-Za-z0-9_]*=', first) or first.startswith(("/", "./", "~/")):
        return True
    if not re.match(r'^[A-Za-z0-9_.-]+$', first):
        return False

    return first in SHELL_BUILTINS or bool(shutil.which(first))


def strip_line_markers(line: str) -> str:
    """Removes markdown bullets, numbering, prompts and backticks from a line."""
    candidate = line.strip()
    # Markers can be stacked ("- $ `cmd`"), so strip until nothing changes.
    for _ in range(5):
        stripped = candidate
        stripped = re.sub(r'^[-*+]\s+', '', stripped)
        stripped = re.sub(r'^\d+[.)]\s+', '', stripped)
        stripped = re.sub(r'^[`$#>]+\s*', '', stripped)
        stripped = re.sub(r'`+$', '', stripped).strip()
        if stripped == candidate:
            break
        candidate = stripped
    return candidate


def extract_command_from_line(line: str, tokens: list) -> str:
    """Extracts a shell command from a model response line.

    Only accepts lines that *start* with a known command token (after stripping
    markdown bullets, numbering and shell prompts). Prose that merely mentions a
    command mid-sentence is rejected, so explanatory text never reaches the shell.
    """
    candidate = strip_line_markers(line)
    for token in tokens:
        if candidate.startswith(token):
            return candidate
    return ""


def extract_single_command(response: str) -> str:
    """Picks one runnable command out of a free-form model response.

    `larp do` used to hand the entire raw response to sanitize_shell_command()
    and offer *that* for execution — so any explanation the model added, or an
    error report produced when every provider failed, could be executed as a
    shell command. A fenced code block wins when present; otherwise the first
    line that actually looks like a command is used.
    """
    if not response:
        return ""

    fenced = re.search(r'```(?:[a-zA-Z]*)\n(.*?)```', response, re.DOTALL)
    candidates = (fenced.group(1) if fenced else response).splitlines()

    for line in candidates:
        candidate = strip_line_markers(line)
        if not candidate or candidate.startswith("```"):
            continue
        if looks_like_a_command(candidate):
            return sanitize_shell_command(candidate)

    return ""


def load_config() -> dict:
    config = json.loads(json.dumps(DEFAULT_CONFIG))
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                user_conf = json.load(f)
                def deep_update(d, u):
                    for k, v in u.items():
                        if isinstance(v, dict) and k in d:
                            deep_update(d[k], v)
                        else:
                            d[k] = v
                deep_update(config, user_conf)
        except Exception:
            pass
    return config


def write_private_json(path: str, data) -> None:
    """Writes JSON with owner-only permissions — these files hold API keys and prompt history."""
    os.makedirs(CONFIG_DIR, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    os.chmod(path, 0o600)


def save_config(config: dict):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    try:
        write_private_json(CONFIG_FILE, config)
        print(f"{GREEN}[+] Configuration saved successfully!{RESET}")
    except Exception as e:
        print(f"{RED}[-] Error saving configuration: {e}{RESET}")


def save_history_entry(query: str, response: str, provider: str):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    history = []
    if os.path.exists(HISTORY_FILE):
        try:
            with open(HISTORY_FILE, "r", encoding="utf-8") as f:
                history = json.load(f)
        except Exception:
            history = []
    
    history.append({
        "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),
        "provider": provider,
        "query": query,
        "response": response[:300] + ("..." if len(response) > 300 else "")
    })
    
    history = history[-50:]
    try:
        write_private_json(HISTORY_FILE, history)
    except Exception:
        pass


# =============================================================================
# VOICE ENGINE (STT & NEURAL TTS)
# =============================================================================

def _clean_text_for_speech(text: str) -> str:
    """Strips kaomoji, code blocks, URLs, markdown, and limits text length for natural speech synthesis."""
    if not text:
        return ""
    clean = re.sub(r'\([^)]*\)', '', text)  # Strip kaomoji
    clean = re.sub(r'```.*?```', 'код скрипта', clean, flags=re.DOTALL)
    clean = re.sub(r'`[^`]*`', '', clean)
    clean = re.sub(r'https?://\S+', '', clean)
    clean = re.sub(r'[\*\#\_~|]', '', clean)
    clean = re.sub(r'^\s*[-*•]\s*', '', clean, flags=re.MULTILINE)
    clean = clean.strip()
    if len(clean) > 400:
        sentences = re.split(r'(?<=[.!?])\s+', clean)
        shortened = []
        cur_len = 0
        for s in sentences:
            if cur_len + len(s) > 380 and shortened:
                break
            shortened.append(s)
            cur_len += len(s)
        clean = " ".join(shortened) if shortened else clean[:350]
    return clean


def _openai_tts_request(text: str, api_key: str, voice: str = "nova") -> bool:
    """Synthesizes studio-quality neural voice using OpenAI TTS API."""
    try:
        url = "https://api.openai.com/v1/audio/speech"
        payload = json.dumps({
            "model": "tts-1",
            "input": text,
            "voice": voice,
            "response_format": "mp3"
        }).encode("utf-8")
        req = urllib.request.Request(
            url,
            data=payload,
            headers={
                "Authorization": f"Bearer {api_key}",
                "Content-Type": "application/json"
            },
            method="POST"
        )
        with urllib.request.urlopen(req, timeout=12) as resp:
            data = resp.read()
            with open(TMP_AUDIO_OUTPUT_MP3, "wb") as f:
                f.write(data)
            return True
    except Exception:
        return False


def tts_synthesize_and_play(text: str, lang: str = "ru"):
    """Synthesizes text into high-quality neural voice audio and plays it via standard Linux audio player."""
    config = load_config()
    vc = config.get("voice", {})
    if not vc.get("enabled", True):
        return

    clean_text = _clean_text_for_speech(text)
    if not clean_text:
        return

    lang = vc.get("language", lang)
    engine = vc.get("tts_engine", "auto")

    # 0. OpenAI Studio Neural TTS (highest studio human quality)
    openai_key = vc.get("openai_api_key", "").strip() or config.get("openai", {}).get("api_key", "").strip()
    if (engine == "openai" or (engine == "auto" and openai_key)) and openai_key:
        tts_voice = vc.get("tts_voice", "nova")
        if _openai_tts_request(clean_text, openai_key, voice=tts_voice):
            if shutil.which("ffmpeg") and shutil.which("aplay"):
                subprocess.run(f"ffmpeg -y -i {TMP_AUDIO_OUTPUT_MP3} {TMP_AUDIO_OUTPUT_WAV} 2>/dev/null && aplay -q {TMP_AUDIO_OUTPUT_WAV} 2>/dev/null", shell=True)
            elif shutil.which("mpv"):
                subprocess.run(f"mpv --no-terminal {TMP_AUDIO_OUTPUT_MP3} 2>/dev/null", shell=True)
            elif shutil.which("paplay"):
                subprocess.run(f"paplay {TMP_AUDIO_OUTPUT_MP3} 2>/dev/null", shell=True)
            return

    # 1. RHVoice offline neural engine (if installed)
    rh_bin = shutil.which("RHVoice-test") or shutil.which("rhvoice-client") or shutil.which("rhvoice")
    if (engine == "rhvoice" or engine == "auto") and rh_bin:
        try:
            voice_name = vc.get("rhvoice_voice", "Elena") if lang == "ru" else "clb"
            cmd = f"echo {shlex.quote(clean_text)} | {rh_bin} -p {voice_name} -o {TMP_AUDIO_OUTPUT_WAV} 2>/dev/null && aplay -q {TMP_AUDIO_OUTPUT_WAV} 2>/dev/null"
            subprocess.run(cmd, shell=True)
            return
        except Exception:
            pass

    # 2. Piper TTS offline
    if (engine == "piper" or engine == "auto") and shutil.which("piper"):
        try:
            cmd = f"echo {shlex.quote(clean_text)} | piper --output_file {TMP_AUDIO_OUTPUT_WAV} 2>/dev/null && aplay -q {TMP_AUDIO_OUTPUT_WAV} 2>/dev/null"
            subprocess.run(cmd, shell=True)
            return
        except Exception:
            pass

    # 3. Google Neural TTS with ffmpeg mastering filter
    if engine in ["auto", "google"]:
        chunks = [clean_text[i:i+180] for i in range(0, len(clean_text), 180)]
        for chunk in chunks[:4]:
            try:
                url = f"https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl={lang}&q={urllib.parse.quote(chunk)}"
                req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"})
                with urllib.request.urlopen(req, timeout=8) as resp:
                    data = resp.read()
                    with open(TMP_AUDIO_OUTPUT_MP3, "wb") as f:
                        f.write(data)

                if shutil.which("ffmpeg") and shutil.which("aplay"):
                    filter_chain = "atempo=1.04,highpass=f=80,lowpass=f=8000,volume=1.25"
                    subprocess.run(f"ffmpeg -y -i {TMP_AUDIO_OUTPUT_MP3} -af \"{filter_chain}\" {TMP_AUDIO_OUTPUT_WAV} 2>/dev/null && aplay -q {TMP_AUDIO_OUTPUT_WAV} 2>/dev/null", shell=True)
                elif shutil.which("mpv"):
                    subprocess.run(f"mpv --no-terminal {TMP_AUDIO_OUTPUT_MP3} 2>/dev/null", shell=True)
                elif shutil.which("paplay"):
                    subprocess.run(f"paplay {TMP_AUDIO_OUTPUT_MP3} 2>/dev/null", shell=True)
                elif shutil.which("spd-say"):
                    subprocess.run(["spd-say", "-l", lang, chunk], check=False)
                return
            except Exception:
                pass

    # 4. espeak / spd-say offline fallbacks
    if shutil.which("spd-say"):
        subprocess.run(["spd-say", "-l", lang, clean_text], check=False)
    elif shutil.which("espeak-ng"):
        subprocess.run(["espeak-ng", "-v", lang, clean_text], check=False)
    elif shutil.which("espeak"):
        subprocess.run(["espeak", "-v", lang, clean_text], check=False)


def _get_wav_rms(path: str, window_bytes: int = 3200) -> float:
    """Computes RMS audio level from the last window_bytes of a 16-bit LE PCM WAV file."""
    try:
        if not os.path.exists(path):
            return 0.0
        sz = os.path.getsize(path)
        if sz <= 44:
            return 0.0
        with open(path, "rb") as f:
            read_len = min(sz - 44, window_bytes)
            f.seek(sz - read_len)
            raw = f.read(read_len)
        if len(raw) < 2:
            return 0.0
        import struct
        samples = struct.unpack(f"<{len(raw)//2}h", raw[:len(raw)//2*2])
        if not samples:
            return 0.0
        sum_sq = sum(s * s for s in samples)
        return (sum_sq / len(samples)) ** 0.5
    except Exception:
        return 0.0


def _wav_has_audio(path: str, threshold: int = 140) -> bool:
    """Returns True if the WAV file contains audio level above threshold anywhere in the recording."""
    try:
        if not os.path.exists(path):
            return False
        sz = os.path.getsize(path)
        if sz <= 44 + 1600:
            return False
        with open(path, "rb") as f:
            f.read(44)  # Skip WAV header
            pcm = f.read()
        import struct
        chunk_size = 3200
        for i in range(0, len(pcm), chunk_size):
            chunk = pcm[i:i+chunk_size]
            if len(chunk) < 2:
                continue
            samples = struct.unpack(f"<{len(chunk)//2}h", chunk[:len(chunk)//2*2])
            if not samples:
                continue
            rms = (sum(s * s for s in samples) / len(samples)) ** 0.5
            if rms > threshold:
                return True
        return False
    except Exception:
        return True


def record_user_speech(duration_sec: int = None, auto_stop: bool = None) -> str:
    """Records microphone audio using pw-record, ffmpeg (pulse), or arecord with live level meter and VAD auto-stop."""
    config = load_config()
    vc = config.get("voice", {})
    if duration_sec is None:
        duration_sec = vc.get("max_duration", 8)
    if auto_stop is None:
        auto_stop = vc.get("auto_stop_silence", True)

    recorder = shutil.which("pw-record") or shutil.which("ffmpeg") or shutil.which("arecord")
    if not recorder:
        print(f"{RED}[-] Error: No audio recorder found (install pipewire, ffmpeg, or alsa-utils){RESET}")
        return ""

    if os.path.exists(TMP_AUDIO_INPUT):
        try:
            os.remove(TMP_AUDIO_INPUT)
        except Exception:
            pass

    viz = AudioVisualizer("Recording... Speak into your microphone!")
    viz.start()

    proc = None
    has_speech = False
    try:
        if shutil.which("pw-record"):
            cmd = ["pw-record", "--rate", "16000", "--channels", "1", TMP_AUDIO_INPUT]
            proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif shutil.which("ffmpeg"):
            cmd = ["ffmpeg", "-y", "-f", "pulse", "-i", "default", "-ac", "1", "-ar", "16000", TMP_AUDIO_INPUT]
            proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            cmd = ["arecord", "-D", "default", "-f", "S16_LE", "-r", "16000", "-c", "1", "-q", TMP_AUDIO_INPUT]
            proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        start_time = time.time()
        silence_counter = 0
        ambient_baseline = 100.0

        while proc.poll() is None:
            elapsed = time.time() - start_time
            if elapsed >= duration_sec:
                break

            time.sleep(0.1)
            rms = _get_wav_rms(TMP_AUDIO_INPUT)
            viz.set_level(rms)

            if elapsed < 0.3:
                ambient_baseline = max(40.0, rms)
                continue

            speech_thresh = max(160.0, ambient_baseline * 1.3)
            silence_thresh = max(120.0, ambient_baseline * 1.1)

            if rms > speech_thresh:
                has_speech = True
                silence_counter = 0
                viz.update(title="Speech detected! Speak naturally...", status="RECORDING")
            elif has_speech:
                if rms < silence_thresh:
                    silence_counter += 1
                else:
                    silence_counter = 0

                if auto_stop and silence_counter >= 11:
                    viz.update(title="Silence detected. Processing speech...", status="TRANSCRIBING")
                    break

    except KeyboardInterrupt:
        pass
    except Exception as e:
        viz.stop()
        print(f"\n{RED}[-] Recording error: {e}{RESET}")
        return ""
    finally:
        if proc:
            try:
                proc.terminate()
                proc.wait(timeout=1.0)
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass
        viz.stop()

    if not os.path.exists(TMP_AUDIO_INPUT):
        print(f"{RED}[-] WAV file not created. Check microphone permissions.{RESET}")
        return ""

    file_size = os.path.getsize(TMP_AUDIO_INPUT)
    if file_size < 1000:
        print(f"{YELLOW}[!] Captured audio file is too small ({file_size} bytes). Check your microphone.{RESET}")
        return ""

    if not has_speech and not _wav_has_audio(TMP_AUDIO_INPUT):
        print(f"{YELLOW}[!] Microphone recorded silence. Is your mic muted or not selected?{RESET}")
        print(f"{DIM}    Tip: run 'alsamixer' or 'pavucontrol' to check input levels.{RESET}")
        return ""

    return TMP_AUDIO_INPUT


def _detect_stt_engine(config: dict) -> str:
    """Returns the best available STT engine name for user info display."""
    vc = config.get("voice", {})
    engine_pref = vc.get("stt_engine", "auto")

    groq_key = vc.get("groq_api_key", "").strip()
    openai_key = config.get("openai", {}).get("api_key", "").strip()

    if engine_pref == "groq" and groq_key.startswith("gsk_"):
        return "Groq Whisper API (online)"
    if engine_pref == "openai" and openai_key:
        return "OpenAI Whisper API (online)"
    if engine_pref == "whisper" and shutil.which("whisper"):
        return f"Local Whisper CLI [{vc.get('whisper_model', 'small')}] (offline)"

    if groq_key.startswith("gsk_"):
        return "Groq Whisper API (online)"
    if openai_key:
        return "OpenAI Whisper API (online)"
    if shutil.which("whisper"):
        return f"Local Whisper CLI [{vc.get('whisper_model', 'small')}] (offline)"
    if shutil.which("whisper-cpp") or shutil.which("whisper.cpp"):
        return "whisper.cpp (offline)"
    return ""


def transcribe_audio_stt(audio_path: str) -> str:
    """Transcribes audio file to text using multilingual auto-detection.
    Priority: Groq Whisper API > OpenAI Whisper API > Python whisper module > local whisper CLI > whisper.cpp
    """
    if not audio_path or not os.path.exists(audio_path):
        return ""

    config = load_config()
    voice_conf = config.get("voice", {})
    groq_key = voice_conf.get("groq_api_key", "").strip()
    openai_key = config.get("openai", {}).get("api_key", "").strip()
    whisper_model = voice_conf.get("whisper_model", "small")

    # --- 1. Groq Whisper API (free tier, fastest) ---
    if groq_key.startswith("gsk_"):
        result = _whisper_api_request(
            audio_path, groq_key,
            endpoint="https://api.groq.com/openai/v1/audio/transcriptions",
            model="whisper-large-v3-turbo"
        )
        if result is not None:
            return result

    # --- 2. OpenAI Whisper API ---
    if openai_key:
        result = _whisper_api_request(
            audio_path, openai_key,
            endpoint="https://api.openai.com/v1/audio/transcriptions",
            model="whisper-1"
        )
        if result is not None:
            return result

    # --- 3. Direct Python whisper module (multilingual) ---
    try:
        import warnings
        warnings.filterwarnings("ignore")
        import whisper
        m = whisper.load_model(whisper_model)
        res = m.transcribe(audio_path, fp16=False)
        text = res.get("text", "").strip()
        if text:
            return text
    except Exception:
        pass

    # --- 4. Local whisper CLI ---
    if shutil.which("whisper"):
        try:
            result = subprocess.run(
                ["whisper", audio_path, "--model", whisper_model,
                 "--output_format", "txt", "--output_dir", "/tmp", "--fp16", "False"],
                capture_output=True, text=True, timeout=60
            )
            txt_file = os.path.join("/tmp", os.path.splitext(os.path.basename(audio_path))[0] + ".txt")
            if os.path.exists(txt_file):
                with open(txt_file, "r", encoding="utf-8") as f:
                    text = f.read().strip()
                os.remove(txt_file)
                return text
            lines = [l.strip() for l in result.stdout.splitlines() if l.strip()]
            return lines[-1] if lines else ""
        except Exception:
            pass

    # --- 5. whisper.cpp binary ---
    for binary in ["whisper-cpp", "whisper.cpp", "main"]:
        if shutil.which(binary):
            model_paths = [
                os.path.expanduser(f"~/.local/share/whisper/ggml-{whisper_model}.bin"),
                f"/usr/share/whisper/ggml-{whisper_model}.bin",
                "/usr/share/whisper/ggml-small.bin",
            ]
            model_path = next((p for p in model_paths if os.path.exists(p)), None)
            if model_path:
                try:
                    result = subprocess.run(
                        [binary, "-m", model_path, "-f", audio_path, "-otxt"],
                        capture_output=True, text=True, timeout=30
                    )
                    lines = [l.strip() for l in result.stdout.splitlines() if l.strip()]
                    return lines[-1] if lines else ""
                except Exception:
                    pass

    return ""


def _whisper_api_request(audio_path: str, api_key: str, endpoint: str, model: str) -> "str | None":
    """Makes a multipart Whisper API transcription request. Returns text or None on failure."""
    try:
        boundary = "LarpBoundary" + str(int(time.time()))
        with open(audio_path, "rb") as f:
            file_bytes = f.read()

        body = bytearray()
        body.extend(f"--{boundary}\r\n".encode())
        body.extend(f'Content-Disposition: form-data; name="model"\r\n\r\n{model}\r\n'.encode())
        body.extend(f"--{boundary}\r\n".encode())
        body.extend(b'Content-Disposition: form-data; name="file"; filename="audio.wav"\r\n')
        body.extend(b'Content-Type: audio/wav\r\n\r\n')
        body.extend(file_bytes)
        body.extend(b'\r\n')
        body.extend(f"--{boundary}--\r\n".encode())

        req = urllib.request.Request(
            endpoint,
            data=bytes(body),
            headers={
                "Authorization": f"Bearer {api_key}",
                "Content-Type": f"multipart/form-data; boundary={boundary}"
            },
            method="POST"
        )
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return data.get("text", "").strip()
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            pass
    except Exception:
        pass
    return None


