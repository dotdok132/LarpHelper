# LARP FETCH / NEOFETCH REPLACEMENT (`larp fetch`)
# =============================================================================

def cmd_fetch():
    """Aesthetic pastel system informer for LarpLinux."""
    user = os.environ.get("USER", "dotdok")
    host = os.environ.get("HOSTNAME", "larp")
    os_name = "LarpLinux Rolling (Arch-based)"
    kernel = subprocess.check_output(["uname", "-sr"], text=True).strip() if shutil.which("uname") else "Linux 7.1.5-zen"
    shell = os.environ.get("SHELL", "/bin/bash").split("/")[-1]
    wm = os.environ.get("XDG_CURRENT_DESKTOP", "Niri / FWM (Wayland)")
    
    pkgs_count = "0"
    try:
        pkgs_count = subprocess.check_output("pacman -Qq | wc -l", shell=True, text=True).strip()
    except Exception:
        pass

    uptime_str = "0m"
    try:
        with open("/proc/uptime", "r") as f:
            up_secs = float(f.readline().split()[0])
            mins = int(up_secs // 60)
            hours = mins // 60
            uptime_str = f"{hours}h {mins % 60}m"
    except Exception:
        pass

    config = load_config()
    ai_provider = config.get("provider", "ollama").upper()

    logo = [
        f"{PINK}   ╭────────────╮   {RESET}",
        f"{PINK}   │    Larp    │   {RESET}",
        f"{PINK}   │  OS Linux  │   {RESET}",
        f"{PINK}   ╰────────────╯   {RESET}",
        f"{CYAN}   ─── v4.0 ───     {RESET}"
    ]

    info = [
        f"{BOLD}{PINK}{user}{RESET}@{BOLD}{CYAN}{host}{RESET}",
        f"{GRAY}─────────────────────────────{RESET}",
        f"{CYAN}OS:{RESET}          {WHITE}{os_name}{RESET}",
        f"{CYAN}Kernel:{RESET}      {WHITE}{kernel}{RESET}",
        f"{CYAN}Uptime:{RESET}      {WHITE}{uptime_str}{RESET}",
        f"{CYAN}Packages:{RESET}    {WHITE}{pkgs_count} (pacman){RESET}",
        f"{CYAN}Shell:{RESET}       {WHITE}{shell}{RESET}",
        f"{CYAN}Compositor:{RESET}  {PINK}{wm}{RESET}",
        f"{CYAN}AI Engine:{RESET}   {BOLD}{PINK}{ai_provider}{RESET}",
        "",
        f"{PINK}███{DEEP_PINK}███{CYAN}███{LIGHT_CYAN}███{PURPLE}███{WHITE}███{RESET}"
    ]

    print()
    max_lines = max(len(logo), len(info))
    for i in range(max_lines):
        l_line = logo[i] if i < len(logo) else "                    "
        r_line = info[i] if i < len(info) else ""
        print(f"{l_line}   {r_line}")
    print()


