def cmd_voice(args: list):
    """Voice Assistant Diagnostic & Setup Dashboard."""
    print_banner()
    sub = args[0].lower() if args else "status"

    if sub in ["test", "diag"]:
        _cmd_voice_test()
    elif sub in ["setup", "config", "configure"]:
        _cmd_voice_setup()
    else:
        _cmd_voice_status()


def _cmd_voice_status():
    config = load_config()
    vc = config.get("voice", {})
    stt_engine = _detect_stt_engine(config) or "Not configured"
    
    recorder = shutil.which("arecord") or shutil.which("pw-record") or "None"
    player = shutil.which("aplay") or shutil.which("mpv") or shutil.which("paplay") or "None"

    print_box(
        "Larp Voice Assistant — Dashboard",
        f"{PINK}{BOLD}Voice Engine Status (^_^){RESET}\n\n"
        f"  {CYAN}STT Engine:{RESET}        {GREEN}{stt_engine}{RESET}\n"
        f"  {CYAN}TTS Engine:{RESET}        {GREEN}{vc.get('tts_engine', 'auto')}{RESET} (Google Translate / Piper / Espeak)\n"
        f"  {CYAN}Audio Input:{RESET}       {GREEN}{recorder}{RESET}\n"
        f"  {CYAN}Audio Output:{RESET}      {GREEN}{player}{RESET}\n"
        f"  {CYAN}Whisper Model:{RESET}     {GREEN}{vc.get('whisper_model', 'small')}{RESET}\n"
        f"  {CYAN}VAD Auto-Stop:{RESET}     {GREEN}{'Enabled (1.1s silence)' if vc.get('auto_stop_silence', True) else 'Disabled'}{RESET}\n"
        f"  {CYAN}Max Rec Time:{RESET}      {GREEN}{vc.get('max_duration', 8)} sec{RESET}\n\n"
        f"{DIM}Quick Commands:\n"
        f"  larp voice test    -> Interactive mic, speaker & STT test\n"
        f"  larp voice setup   -> Interactive voice settings wizard\n"
        f"  larp talk          -> Start interactive voice session{RESET}",
        border_color=PINK
    )


def _cmd_voice_test():
    print_box("Larp Voice Diagnostics Test", f"{PINK}Running audio & speech recognition test...{RESET}")
    print()

    # 1. Mic check
    print(f"{CYAN}Step 1: Testing microphone recording (3 seconds)...{RESET}")
    print(f"{DIM}Please speak a test phrase into your microphone!{RESET}")
    audio_path = record_user_speech(duration_sec=3, auto_stop=False)

    if not audio_path:
        print(f"{RED}[-] Mic test failed! Audio was not recorded or silent.{RESET}")
        return

    print(f"{GREEN}[+] Audio successfully recorded! ({os.path.getsize(audio_path)} bytes){RESET}")

    # 2. Speaker check
    print(f"\n{CYAN}Step 2: Playing back your recorded audio through speakers...{RESET}")
    if shutil.which("aplay"):
        subprocess.run(["aplay", "-q", audio_path], check=False)
    elif shutil.which("paplay"):
        subprocess.run(["paplay", audio_path], check=False)

    # 3. STT check
    print(f"\n{CYAN}Step 3: Testing Speech-to-Text transcription...{RESET}")
    text = transcribe_audio_stt(audio_path)
    if text:
        print(f"{GREEN}[+] STT Recognized Text: {RESET}{BOLD}{text}{RESET}")
    else:
        print(f"{YELLOW}[!] STT could not transcribe audio (no STT key or local whisper).{RESET}")

    # 4. TTS check
    print(f"\n{CYAN}Step 4: Testing TTS speech output...{RESET}")
    tts_synthesize_and_play("Тест прошел успешно! Голосовой помощник Larp работает отлично.")
    print(f"{GREEN}[+] Voice diagnostic complete! (^_^){RESET}\n")


def _cmd_voice_setup():
    config = load_config()
    vc = config.get("voice", {})

    print(f"{BOLD}{PINK}=== Larp Voice Assistant Setup Wizard ==={RESET}\n")
    print(f"1) 🎙️ Select & Auto-Install Voice Engine (RHVoice Elena / Aleksandr / OpenAI / Piper)")
    print(f"2) ⚡ Configure Groq Whisper API Key (Free fast online STT)")
    print(f"3) 🧠 Change Local Whisper Model (tiny / base / small / medium)")
    print(f"4) ⏱️ Toggle VAD Silence Auto-Stop ({'Enabled' if vc.get('auto_stop_silence', True) else 'Disabled'})")
    print(f"5) ⌛ Change Max Recording Duration ({vc.get('max_duration', 8)}s)")
    print(f"6) Exit setup\n")

    try:
        choice = input(f"{CYAN}Select option [1-6]: {RESET}").strip()
    except (KeyboardInterrupt, EOFError):
        return

    if choice == "1":
        _setup_voice_engine_installer(config)
    elif choice == "2":
        try:
            key = input(f"{PINK}Enter Groq API Key (gsk_...): {RESET}").strip()
            if key:
                vc["groq_api_key"] = key
                config["voice"] = vc
                save_config(config)
        except (KeyboardInterrupt, EOFError):
            pass
    elif choice == "3":
        print(f"\nAvailable Whisper Models:\n  tiny (fastest)\n  base\n  small (recommended)\n  medium (best quality)\n")
        try:
            m = input(f"{PINK}Select model: {RESET}").strip().lower()
            if m in ["tiny", "base", "small", "medium", "large"]:
                vc["whisper_model"] = m
                config["voice"] = vc
                save_config(config)
        except (KeyboardInterrupt, EOFError):
            pass
    elif choice == "4":
        cur = vc.get("auto_stop_silence", True)
        vc["auto_stop_silence"] = not cur
        config["voice"] = vc
        save_config(config)
        print(f"{GREEN}[+] Auto-stop on silence is now {'Enabled' if vc['auto_stop_silence'] else 'Disabled'}.{RESET}")
    elif choice == "5":
        try:
            sec = input(f"{PINK}Enter max duration in seconds [3-30]: {RESET}").strip()
            if sec.isdigit():
                vc["max_duration"] = int(sec)
                config["voice"] = vc
                save_config(config)
        except (KeyboardInterrupt, EOFError):
            pass


def _setup_voice_engine_installer(config: dict):
    vc = config.get("voice", {})
    pkg_name, install_prefix, _, _ = detect_package_manager()

    print(f"\n{BOLD}{PINK}=== Select & Auto-Install Voice Engine ==={RESET}\n")
    print(f"1) 🌸 RHVoice Elena (Russian Female, Natural Offline Voice)")
    print(f"2) 👨 RHVoice Aleksandr (Russian Male, Natural Offline Voice)")
    print(f"3) 🌟 OpenAI Nova (Studio Quality Online Voice)")
    print(f"4) 🌟 OpenAI Shimmer (Studio Quality Female Online Voice)")
    print(f"5) ⚡ Piper Neural TTS (Offline Engine)")
    print(f"6) 🌐 Google Translate Voice (Standard)\n")

    try:
        v_choice = input(f"{CYAN}Select voice [1-6]: {RESET}").strip()
    except (KeyboardInterrupt, EOFError):
        return

    if v_choice in ["1", "2"]:
        voice_target = "Elena" if v_choice == "1" else "Aleksandr"
        voice_pkg = "rhvoice-voice-elena" if v_choice == "1" else "rhvoice-voice-aleksandr-hq"
        
        print(f"\n{PINK}[+] Auto-installing RHVoice ({voice_target}) via {pkg_name}...{RESET}")
        if pkg_name == "pacman":
            cmd = f"{install_prefix} rhvoice rhvoice-language-russian {voice_pkg}"
        elif pkg_name == "apt":
            cmd = f"{install_prefix} rhvoice rhvoice-russian"
        else:
            cmd = f"{install_prefix} rhvoice"

        print(f"{DIM}Executing: {cmd}{RESET}")
        res = subprocess.run(cmd, shell=True)
        if res.returncode == 0:
            vc["tts_engine"] = "rhvoice"
            vc["rhvoice_voice"] = voice_target
            config["voice"] = vc
            save_config(config)
            print(f"{GREEN}[+] RHVoice ({voice_target}) installed and set as active voice!{RESET}")
            tts_synthesize_and_play(f"Голос {voice_target} успешно установлен и подключён!")
        else:
            print(f"{YELLOW}[!] Package installation finished with exit code {res.returncode}.{RESET}")

    elif v_choice in ["3", "4"]:
        v_name = "nova" if v_choice == "3" else "shimmer"
        vc["tts_engine"] = "openai"
        vc["tts_voice"] = v_name
        config["voice"] = vc
        save_config(config)
        print(f"{GREEN}[+] Voice set to OpenAI ({v_name})!{RESET}")
        tts_synthesize_and_play("Голосовой ассистент переключен на студийный голос OpenAI.")

    elif v_choice == "5":
        print(f"\n{PINK}[+] Installing Piper Neural TTS via {pkg_name}...{RESET}")
        cmd = f"{install_prefix} piper"
        subprocess.run(cmd, shell=True)
        vc["tts_engine"] = "piper"
        config["voice"] = vc
        save_config(config)

    elif v_choice == "6":
        vc["tts_engine"] = "google"
        config["voice"] = vc
        save_config(config)
        print(f"{GREEN}[+] Voice set to Google Neural TTS.{RESET}")


def cmd_talk():
    """Continuous hands-free interactive voice loop."""
    print_banner()

    config = load_config()
    stt_engine = _detect_stt_engine(config)

    if not stt_engine:
        print_box(
            "Voice Assistant — Setup Required",
            f"{YELLOW}No speech-to-text (STT) engine is configured!{RESET}\n\n"
            f"{CYAN}To enable voice transcription, choose one of:\n{RESET}"
            f"  {PINK}1. Groq Whisper API (FREE, fastest):{RESET}\n"
            f"     Get key at groq.com -> {BOLD}larp voice setup{RESET}\n"
            f"  {PINK}2. Local Whisper CLI (offline, no key needed):{RESET}\n"
            f"     {BOLD}sudo pacman -S python-openai-whisper{RESET}\n"
            f"  {PINK}3. OpenAI Whisper API:{RESET}\n"
            f"     {BOLD}larp config{RESET} -> option 4\n\n"
            f"{DIM}Running in text-only chat mode instead.{RESET}",
            border_color=YELLOW
        )
        print()
        cmd_chat()
        return

    vc = config.get("voice", {})
    auto_stop = vc.get("auto_stop_silence", True)

    print_box(
        "Larp AI Voice Assistant",
        f"{PINK}Hands-free Voice Session Active! (^_^){RESET}\n"
        f"{CYAN}STT Engine:{RESET}   {GREEN}{stt_engine}{RESET}\n"
        f"{CYAN}VAD Mode:{RESET}     {GREEN}{'Auto-Stop on 1.1s Silence' if auto_stop else 'Fixed Duration'}{RESET}\n"
        f"{CYAN}Speak into your microphone. Say 'exit' or Ctrl+C to leave.{RESET}"
    )
    print()

    while True:
        try:
            print(f"\n{BOLD}{PINK}>>> Listening...{RESET} {DIM}(speak now){RESET}")
            audio_file = record_user_speech()
            if not audio_file:
                try:
                    user_text = input(f"{PINK}{BOLD}No audio captured. Type query (or Enter to retry): {RESET}").strip()
                    if not user_text:
                        continue
                except (KeyboardInterrupt, EOFError):
                    break
            else:
                print(f"{CYAN}Transcribing...{RESET}")
                user_text = transcribe_audio_stt(audio_file)

                if not user_text:
                    try:
                        user_text = input(f"{PINK}{BOLD}Could not understand speech. Type query (or Enter to retry): {RESET}").strip()
                        if not user_text:
                            continue
                    except (KeyboardInterrupt, EOFError):
                        break

            print(f"\n{BOLD}{CYAN}You:{RESET} {user_text}")

            if user_text.lower() in ["exit", "quit", "пока", "выход", "стоп"]:
                tts_synthesize_and_play("До свидания! Хорошего дня!")
                print(f"{CYAN}Goodbye! (^_^){RESET}")
                break

            voice_prompt = (
                f"{user_text}\n\n"
                "[Инструкция голосового ответа: Отвечай максимально кратко, в 1-2 предложениях, "
                "по существу. НЕ ИСПОЛЬЗУЙ никаких смайлов, эмодзи и каомодзи!]"
            )
            response = ask_ai(voice_prompt)
            p_name = config.get("provider", "ollama").upper()
            print_box(f"Larp AI ({p_name})", response, border_color=PINK)

            tts_synthesize_and_play(response, lang="ru")

        except (KeyboardInterrupt, EOFError):
            print(f"\n{CYAN}Exiting voice session. Bye! (^_^){RESET}")
            break


def cmd_listen(args: list):
    """Record single voice query and respond."""
    duration = None
    if args and args[0].isdigit():
        duration = int(args[0])

    print_banner()
    print(f"{CYAN}Recording voice query...{RESET}")
    audio_file = record_user_speech(duration_sec=duration)
    text = transcribe_audio_stt(audio_file)

    if not text:
        print(f"{YELLOW}[!] Could not transcribe speech.{RESET}")
        return

    print(f"{BOLD}{CYAN}Transcribed Query:{RESET} {text}\n")
    voice_prompt = (
        f"{text}\n\n"
        "[Инструкция голосового ответа: Отвечай максимально кратко, в 1-2 предложениях, "
        "по существу. НЕ ИСПОЛЬЗУЙ никаких смайлов, эмодзи и каомодзи!]"
    )
    response = ask_ai(voice_prompt)
    print_box("Larp AI Response", response, border_color=PINK)
    tts_synthesize_and_play(response)


def cmd_speak(args: list):
    """Synthesize text into spoken voice."""
    if not args:
        print(f"{CYAN}Enter text to speak out loud:{RESET}")
        try:
            text = input(" > ").strip()
        except (KeyboardInterrupt, EOFError):
            return
    else:
        text = " ".join(args)

    if text:
        print(f"{PINK}Speaking text out loud...{RESET}")
        tts_synthesize_and_play(text)


def load_custom_recipes() -> dict:
    if os.path.exists(CUSTOM_RECIPES_FILE):
        try:
            with open(CUSTOM_RECIPES_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return {}
    return {}


def save_custom_recipe(name: str, desc: str, cmd: str):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    customs = load_custom_recipes()
    customs[name] = {"desc": desc, "cmd": cmd}
    try:
        write_private_json(CUSTOM_RECIPES_FILE, customs)
        print(f"{GREEN}[+] Recipe '{name}' saved to your collection!{RESET}")
    except Exception as e:
        print(f"{RED}[-] Error saving recipe: {e}{RESET}")


def get_all_recipes() -> dict:
    recipes = dict(KNOWN_RECIPES)
    customs = load_custom_recipes()
    for k, v in customs.items():
        recipes[k] = v
    return recipes


def extract_search_keywords(text: str) -> str:
    stop_words = {
        "why", "how", "what", "where", "when", "who", "is", "the",
        "best", "a", "an", "in", "on", "for", "please", "explain", "tell",
        "show", "can", "you", "does", "do", "which"
    }
    words = re.findall(r'\w+', text.lower())
    filtered = [w for w in words if w not in stop_words and len(w) > 1]
    return " ".join(filtered) if filtered else text


def web_search_duckduckgo(query: str) -> list:
    clean_query = extract_search_keywords(query)
    if not clean_query or len(clean_query.strip()) < 3:
        clean_query = f"{query} linux"

    results = []
    try:
        url = f"https://html.duckduckgo.com/html/?q={urllib.parse.quote(clean_query)}"
        req = urllib.request.Request(
            url,
            headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64; rv:120.0) Gecko/20100101 Firefox/120.0"}
        )
        with urllib.request.urlopen(req, timeout=5) as resp:
            html = resp.read().decode("utf-8", errors="ignore")
            snippets = re.findall(r'<a class="result__snippet[^>]*>(.*?)</a>', html, re.DOTALL)
            clean_snippets = [re.sub(r'<[^>]+>', '', s).strip() for s in snippets[:4]]
            for snippet in clean_snippets:
                if snippet and len(snippet) > 15:
                    results.append(snippet)
    except Exception:
        pass
    return results


def search_arch_packages_api(query: str) -> list:
    clean_query = extract_search_keywords(query)
    if not clean_query or len(clean_query.strip()) < 3:
        return []
    pkgs = []
    try:
        url = f"https://archlinux.org/packages/search/json/?q={urllib.parse.quote(clean_query)}"
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=4) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            for item in data.get("results", [])[:5]:
                pkgs.append(f"{item['pkgname']} — {item['pkgdesc']}")
    except Exception:
        pass
    return pkgs


def search_aur_packages_api(query: str) -> list:
    clean_query = extract_search_keywords(query)
    if not clean_query or len(clean_query.strip()) < 3:
        return []
    pkgs = []
    try:
        url = f"https://aur.archlinux.org/rpc/?v=5&type=search&arg={urllib.parse.quote(clean_query)}"
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=4) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            for item in data.get("results", [])[:5]:
                pkgs.append(f"{item['Name']} (AUR) — {item.get('Description', '')}")
    except Exception:
        pass
    return pkgs


def get_full_web_context(query: str) -> str:
    config = load_config()
    if not config.get("web_search", True):
        return ""

    context_blocks = []

    snippets = web_search_duckduckgo(query)
    if snippets:
        context_blocks.append("Web Search Results (DuckDuckGo):\n" + "\n".join(f"• {s}" for s in snippets))

    pkg_manager, _, _, _ = detect_package_manager()
    if pkg_manager == "pacman":
        arch_pkgs = search_arch_packages_api(query)
        aur_pkgs = search_aur_packages_api(query)
        combined_pkgs = arch_pkgs + aur_pkgs
        if combined_pkgs:
            context_blocks.append("Found Arch/AUR Packages:\n" + "\n".join(f" - {p}" for p in combined_pkgs[:7]))

    return "\n\n".join(context_blocks)


def read_meminfo() -> tuple:
    """Returns (MemTotal, MemAvailable) in kB, or (0, 0).

    Reading by key rather than by line index: the order of /proc/meminfo is not
    guaranteed, and MemAvailable is absent on kernels older than 3.14.
    """
    values = {}
    try:
        with open("/proc/meminfo", "r") as f:
            for line in f:
                key, _, rest = line.partition(":")
                if key in ("MemTotal", "MemAvailable", "MemFree"):
                    values[key] = int(rest.split()[0])
    except Exception:
        return (0, 0)

    total = values.get("MemTotal", 0)
    available = values.get("MemAvailable", values.get("MemFree", 0))
    return (total, available)


def get_system_info() -> str:
    info_lines = []

    user = os.environ.get("USER", "user")
    host = os.environ.get("HOSTNAME") or socket.gethostname() or "linux"
    info_lines.append(f"User/Host: {user}@{host}")

    if os.path.exists("/etc/os-release"):
        try:
            with open("/etc/os-release", "r") as f:
                for line in f:
                    if line.startswith("PRETTY_NAME="):
                        os_value = line.split("=")[1].strip().strip('"')
                        info_lines.append(f"OS: {os_value}")
                        break
        except Exception:
            pass

    try:
        kernel = subprocess.check_output(["uname", "-sr"], text=True).strip()
        info_lines.append(f"Linux Kernel: {kernel}")
    except Exception:
        pass

    xdg_desktop = os.environ.get("XDG_CURRENT_DESKTOP", "")
    wayland_disp = os.environ.get("WAYLAND_DISPLAY", "")
    info_lines.append(f"Graphics/DE: {xdg_desktop or 'Wayland'} (WAYLAND_DISPLAY={wayland_disp or 'wayland-0'})")

    shell = os.environ.get("SHELL", "/bin/bash")
    info_lines.append(f"Shell: {shell}")

    pkg_name, _, _, _ = detect_package_manager()
    init_name, _, _, _ = detect_init_system()
    info_lines.append(f"Package Manager: {pkg_name}")
    info_lines.append(f"Init System: {init_name}")

    try:
        cpu_cmd = "grep -m1 'model name' /proc/cpuinfo | cut -d: -f2"
        cpu = subprocess.check_output(cpu_cmd, shell=True, text=True).strip()
        if cpu:
            info_lines.append(f"CPU: {cpu}")
    except Exception:
        pass

    total_kb, avail_kb = read_meminfo()
    if total_kb:
        total_gb = round(total_kb / 1024 / 1024, 1)
        avail_gb = round(avail_kb / 1024 / 1024, 1)
        info_lines.append(f"RAM: {avail_gb} GB free of {total_gb} GB")

    return "\n".join(info_lines)


def get_available_ollama_models(ollama_url: str) -> list:
    """Returns the installed model names, tags included ("llama3:8b").

    The tag used to be stripped, so a configured "llama3:8b" never matched what
    was installed and larp silently answered with a different model.
    """
    try:
        req = urllib.request.Request(f"{ollama_url}/api/tags", method="GET")
        with urllib.request.urlopen(req, timeout=2) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return [m.get("name", "") for m in data.get("models", []) if m.get("name")]
    except Exception:
        return []


def model_is_installed(target: str, installed: list) -> bool:
    """Matches a configured model against installed ones, tolerating the tag.

    "mistral" matches "mistral:latest", and "llama3:8b" matches only itself.
    """
    if not target:
        return False
    if target in installed:
        return True
    if ":" in target:
        return False
    return any(name.split(":")[0] == target for name in installed)


def check_ollama_status(ollama_url: str) -> bool:
    try:
        req = urllib.request.Request(ollama_url, method="GET")
        with urllib.request.urlopen(req, timeout=2):
            return True
    except Exception:
        return False


def service_command(action: str, service: str) -> list:
    """Builds the init-system command for starting/stopping a system service.

    sudo is included because these are system-level units: without it systemctl
    returns "access denied", and with capture_output that failure was invisible.
    """
    init_name, _, _, _ = detect_init_system()
    prefix = ["sudo"] if os.geteuid() != 0 and shutil.which("sudo") else []

    if init_name == "systemd":
        return prefix + ["systemctl", action, service]
    if init_name == "OpenRC":
        return prefix + ["rc-service", service, action]
    if init_name == "runit":
        return prefix + ["sv", action, service]
    if init_name == "dinit":
        return prefix + ["dinitctl", action, service]
    if init_name == "sysvinit":
        return prefix + ["service", service, action]
    return []


def start_ollama_daemon(ollama_url: str) -> bool:
    """Starts Ollama, preferring the user unit and falling back to `ollama serve`.

    Returns True once the daemon answers on `ollama_url`.
    """
    attempts = []

    # A user-level unit needs no password, so it is tried before the system one.
    if shutil.which("systemctl") and detect_init_system()[0] == "systemd":
        attempts.append(["systemctl", "--user", "start", "ollama"])

    service_cmd = service_command("start", "ollama")
    if service_cmd:
        attempts.append(service_cmd)

    for command in attempts:
        try:
            result = subprocess.run(command, capture_output=True, text=True, check=False)
        except Exception:
            continue
        if result.returncode == 0:
            for _ in range(10):
                time.sleep(1)
                if check_ollama_status(ollama_url):
                    return True
        elif result.stderr.strip():
            print(f"{DIM}    {command[0]}: {result.stderr.strip().splitlines()[0]}{RESET}")

    if shutil.which("ollama"):
        try:
            subprocess.Popen(["ollama", "serve"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception as e:
            print(f"{RED}[-] Error launching Ollama: {e}{RESET}")
        for _ in range(10):
            time.sleep(1)
            if check_ollama_status(ollama_url):
                return True

    return False


def ensure_ollama_and_get_model(config: dict) -> str:
    """Makes sure Ollama is reachable and returns the model to use.

    Raises ProviderError rather than exiting: this runs inside a provider, so
    sys.exit() here used to kill the whole process — taking down the fallback
    chain (the next provider was never tried) and any running `larp chat`.
    """
    global OLLAMA_STARTED_BY_LARP
    ollama_conf = config.get("ollama", {})
    ollama_url = ollama_conf.get("url", OLLAMA_URL)
    target_model = ollama_conf.get("model", DEFAULT_MODEL)

    if not check_ollama_status(ollama_url):
        if not ollama_conf.get("auto_start", True):
            raise ProviderError(
                f"{RED}Ollama is not running at {ollama_url} and auto_start is disabled.{RESET}\n"
                f"{CYAN}Start it yourself, or: larp config set ollama.auto_start true{RESET}")

        print(f"{PINK}Ollama is not running. Starting Ollama daemon...{RESET}")
        if not start_ollama_daemon(ollama_url):
            raise ProviderError(
                f"{RED}Could not start Ollama or connect to {ollama_url}.{RESET}\n"
                f"{CYAN}Check 'systemctl status ollama', or run 'ollama serve' manually.{RESET}")

        OLLAMA_STARTED_BY_LARP = True
        print(f"{GREEN}[+] Ollama service started successfully!{RESET}\n")

    models = get_available_ollama_models(ollama_url)
    if model_is_installed(target_model, models):
        return target_model

    print(f"{PINK}Model '{target_model}' is not installed. Pulling it (ollama pull {target_model})...{RESET}")
    if not shutil.which("ollama"):
        raise ProviderError(
            f"{RED}Model '{target_model}' is not installed and the ollama CLI was not found.{RESET}\n"
            f"{CYAN}Installed models: {', '.join(models) if models else 'none'}{RESET}")

    pull_res = subprocess.run(["ollama", "pull", target_model])
    if pull_res.returncode != 0:
        # Only now settle for something else, and say so — silently answering
        # with a different model than the configured one is a surprise.
        if models:
            substitute = models[0]
            print(f"{YELLOW}[!] Could not pull '{target_model}'. Using installed model "
                  f"'{substitute}' instead.{RESET}")
            return substitute
        raise ProviderError(
            f"{RED}Failed to pull model '{target_model}' and no other model is installed.{RESET}")

    return target_model


def stop_ollama_and_free_vram(config: dict = None):
    """Stops Ollama again, but only if larp was the one that started it."""
    global OLLAMA_STARTED_BY_LARP
    if not OLLAMA_STARTED_BY_LARP:
        return
    if config is not None and not config.get("ollama", {}).get("auto_stop", True):
        return

    commands = []
    if shutil.which("systemctl") and detect_init_system()[0] == "systemd":
        commands.append(["systemctl", "--user", "stop", "ollama"])
    service_cmd = service_command("stop", "ollama")
    if service_cmd:
        commands.append(service_cmd)

    for command in commands:
        try:
            if subprocess.run(command, capture_output=True, text=True, check=False).returncode == 0:
                break
        except Exception:
            continue

    OLLAMA_STARTED_BY_LARP = False


def rank_gemini_model(model_name: str):
    """Sort key for auto-selecting a Gemini model: newest first, flash over pro, stable over preview.

    Ranking by parsed version number rather than hardcoded names means new Gemini
    releases are preferred automatically, without editing this function.
    """
    name = model_name.lower()
    version_match = re.search(r'gemini-(\d+)(?:\.(\d+))?', name)
    major = int(version_match.group(1)) if version_match else 0
    minor = int(version_match.group(2)) if version_match and version_match.group(2) else 0

    is_preview = 1 if ("preview" in name or "exp" in name) else 0
    tier = 0 if "flash" in name else (1 if "pro" in name else 2)

    # Negative version numbers so that higher versions sort first.
    return (is_preview, -major, -minor, tier, len(name))


def get_valid_gemini_models_from_api(api_key: str) -> list:
    """Queries Google ModelService.ListModels API for valid text generation models."""
    try:
        url = f"https://generativelanguage.googleapis.com/v1beta/models?key={api_key}"
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=8) as resp:
            if resp.status == 200:
                data = json.loads(resp.read().decode("utf-8"))
                valid_models = []
                for m in data.get("models", []):
                    name = m.get("name", "").replace("models/", "")
                    methods = m.get("supportedGenerationMethods", [])
                    if "generateContent" in methods and not any(bad in name.lower() for bad in ["-tts", "embedding", "imagen", "bison", "aqa"]):
                        valid_models.append(name)
                return valid_models
    except Exception:
        pass
    return []


# =============================================================================
# UNIVERSAL PROVIDERS ENGINE (Ollama, Gemini, Claude, OpenAI, OpenRouter)
# =============================================================================
#
# Every provider has the signature
#     func(prompt, extra_web_context, config, on_chunk=None) -> str
# and returns the complete answer. When `on_chunk` is given the provider uses
# the streaming endpoint and calls it with each fragment as it arrives, so the
# caller can show the answer being written instead of a spinner.


def build_full_prompt(prompt: str, extra_web_context: str) -> str:
    """Assembles the user-visible prompt shared by every provider."""
    full_prompt = f"[SYSTEM & USER CONTEXT]\n{get_system_info()}\n\n"
    if extra_web_context:
        full_prompt += f"[WEB SEARCH CONTEXT]\n{extra_web_context}\n\n"
    return full_prompt + f"[USER PROMPT]\n{prompt}"


def iter_json_lines(resp):
    """Yields parsed objects from an NDJSON stream (Ollama)."""
    for raw in resp:
        line = raw.decode("utf-8", errors="ignore").strip()
        if not line:
            continue
        try:
            yield json.loads(line)
        except json.JSONDecodeError:
            continue


def iter_sse_events(resp):
    """Yields parsed `data:` payloads from a Server-Sent Events stream."""
    for raw in resp:
        line = raw.decode("utf-8", errors="ignore").strip()
        if not line or not line.startswith("data:"):
            continue
        payload = line[len("data:"):].strip()
        if payload == "[DONE]":
            return
        try:
            yield json.loads(payload)
        except json.JSONDecodeError:
            continue


def query_provider_ollama(prompt: str, extra_web_context: str, config: dict, on_chunk=None) -> str:
    ollama_conf = config.get("ollama", {})
    ollama_url = ollama_conf.get("url", OLLAMA_URL)
    active_model = ensure_ollama_and_get_model(config)

    payload = {
        "model": active_model,
        "prompt": build_full_prompt(prompt, extra_web_context),
        "system": build_system_prompt(),
        "stream": bool(on_chunk),
        "keep_alive": ollama_conf.get("keep_alive", 0)
    }

    req = urllib.request.Request(
        f"{ollama_url}/api/generate",
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST"
    )

    spinner = Spinner(f"Larp AI [Ollama/{active_model}] generating response...")
    spinner.start()

    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            if resp.status != 200:
                raise ProviderError(f"{RED}Ollama Error: HTTP status {resp.status}{RESET}")

            if not on_chunk:
                spinner.stop()
                result = json.loads(resp.read().decode("utf-8"))
                return result.get("response", "").strip()

            collected = []
            for event in iter_json_lines(resp):
                if event.get("error"):
                    raise ProviderError(f"{RED}Ollama Error: {event['error']}{RESET}")
                fragment = event.get("response", "")
                if fragment:
                    spinner.stop()
                    collected.append(fragment)
                    on_chunk(fragment)
                if event.get("done"):
                    break
            return "".join(collected).strip()
    except ProviderError:
        raise
    except Exception as e:
        raise ProviderError(f"{RED}Ollama Connection Error: {e}{RESET}")
    finally:
        spinner.stop()
        stop_ollama_and_free_vram(config)


def query_provider_gemini(prompt: str, extra_web_context: str, config: dict, on_chunk=None) -> str:
    gemini_conf = config.get("gemini", {})
    api_key = gemini_conf.get("api_key", "").strip()
    user_model = gemini_conf.get("model", "auto").strip()

    if not api_key:
        raise ProviderError(f"{RED}[-] Error: Gemini API Key is not set!\n{RESET}"
                f"{CYAN}Run {BOLD}larp config{RESET}{CYAN} to set up your API key.{RESET}")

    full_prompt = build_full_prompt(prompt, extra_web_context)

    payload = {
        "system_instruction": {
            "parts": [{"text": build_system_prompt()}]
        },
        "contents": [
            {
                "parts": [{"text": full_prompt}]
            }
        ]
    }
    data = json.dumps(payload).encode("utf-8")

    spinner = Spinner(f"Larp AI [Google Gemini] generating response...")
    spinner.start()

    discovered_models = get_valid_gemini_models_from_api(api_key)

    if discovered_models:
        discovered_models.sort(key=rank_gemini_model)

    candidate_models = []
    if user_model and user_model != "auto" and not any(bad in user_model.lower() for bad in ["-tts", "embedding", "imagen"]):
        candidate_models.append(user_model)

    if discovered_models:
        candidate_models.extend(discovered_models)

    fallback_defaults = ["gemini-2.5-flash", "gemini-2.0-flash", "gemini-2.5-pro", "gemini-1.5-flash", "gemini-pro"]
    candidate_models.extend(fallback_defaults)

    seen = set()
    candidate_models = [m for m in candidate_models if m and not (m in seen or seen.add(m))]

    try:
        return try_gemini_models(candidate_models, data, api_key, spinner, on_chunk)
    finally:
        # Kept outside the per-model loop: stopping it there left the remaining
        # attempts with no progress indicator at all.
        spinner.stop()


def try_gemini_models(candidate_models: list, data: bytes, api_key: str, spinner, on_chunk) -> str:
    """Tries each candidate model in turn, returning the first usable answer."""
    last_error = ""
    for model in candidate_models:
        method = "streamGenerateContent?alt=sse&" if on_chunk else "generateContent?"
        endpoint = f"https://generativelanguage.googleapis.com/v1beta/models/{model}:{method}key={api_key}"
        req = urllib.request.Request(
            endpoint,
            data=data,
            headers={"Content-Type": "application/json"},
            method="POST"
        )
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                if resp.status != 200:
                    continue

                if not on_chunk:
                    spinner.stop()
                    result = json.loads(resp.read().decode("utf-8"))
                    candidates = result.get("candidates", [])
                    if candidates:
                        parts = candidates[0].get("content", {}).get("parts", [])
                        if parts:
                            return parts[0].get("text", "").strip()
                    continue

                collected = []
                for event in iter_sse_events(resp):
                    for candidate in event.get("candidates", []):
                        for part in candidate.get("content", {}).get("parts", []):
                            fragment = part.get("text", "")
                            if fragment:
                                spinner.stop()
                                collected.append(fragment)
                                on_chunk(fragment)
                if collected:
                    return "".join(collected).strip()
                continue
        except urllib.error.HTTPError as e:
            last_error = e.read().decode("utf-8", errors="ignore")
            if e.code in [400, 404, 429, 500, 502, 503, 504]:
                continue
            raise ProviderError(f"{RED}Gemini API Error ({e.code}): {last_error}{RESET}")
        except Exception as e:
            raise ProviderError(f"{RED}Gemini API Request Error: {e}{RESET}")

    raise ProviderError(f"{RED}Gemini API Error: None of the models {candidate_models[:4]} matched your API key.\nDetails: {last_error}{RESET}")


def query_provider_claude(prompt: str, extra_web_context: str, config: dict, on_chunk=None) -> str:
    claude_conf = config.get("claude", {})
    api_key = claude_conf.get("api_key", "").strip()
    model = claude_conf.get("model", "claude-opus-5").strip()

    if not api_key:
        raise ProviderError(f"{RED}[-] Error: Anthropic Claude API Key is not set!\n{RESET}"
                f"{CYAN}Run {BOLD}larp config{RESET}{CYAN} to set up your API key.{RESET}")

    endpoint = "https://api.anthropic.com/v1/messages"

    payload = {
        "model": model,
        "max_tokens": 2048,
        "system": build_system_prompt(),
        "messages": [
            {"role": "user", "content": build_full_prompt(prompt, extra_web_context)}
        ]
    }
    if on_chunk:
        payload["stream"] = True

    req = urllib.request.Request(
        endpoint,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "x-api-key": api_key,
            "anthropic-version": "2023-06-01",
            "content-type": "application/json"
        },
        method="POST"
    )

    spinner = Spinner(f"Larp AI [Anthropic Claude/{model}] generating response...")
    spinner.start()

    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            if resp.status != 200:
                raise ProviderError(f"{RED}Claude API Error: HTTP status {resp.status}{RESET}")

            if not on_chunk:
                spinner.stop()
                result = json.loads(resp.read().decode("utf-8"))
                contents = result.get("content", [])
                if contents:
                    return contents[0].get("text", "").strip()
                raise ProviderError(f"{RED}Empty response from Claude API.{RESET}")

            collected = []
            for event in iter_sse_events(resp):
                event_type = event.get("type")
                if event_type == "error":
                    message = event.get("error", {}).get("message", "unknown error")
                    raise ProviderError(f"{RED}Claude API Error: {message}{RESET}")
                if event_type == "content_block_delta":
                    fragment = event.get("delta", {}).get("text", "")
                    if fragment:
                        spinner.stop()
                        collected.append(fragment)
                        on_chunk(fragment)
            if not collected:
                raise ProviderError(f"{RED}Empty response from Claude API.{RESET}")
            return "".join(collected).strip()
    except urllib.error.HTTPError as e:
        err_msg = e.read().decode("utf-8", errors="ignore")
        raise ProviderError(f"{RED}Claude API Error ({e.code}): {err_msg}{RESET}")
    except ProviderError:
        raise
    except Exception as e:
        raise ProviderError(f"{RED}Claude API Request Error: {e}{RESET}")
    finally:
        spinner.stop()


def read_openai_style_response(resp, spinner, on_chunk, label: str) -> str:
    """Reads a chat-completions response, streaming or not.

    OpenAI and OpenRouter speak the same wire format, so both providers share
    this instead of keeping two copies of the parsing in sync.
    """
    if not on_chunk:
        spinner.stop()
        result = json.loads(resp.read().decode("utf-8"))
        # OpenRouter reports upstream provider failures as a 200 with an "error"
        # object instead of "choices" — report it rather than printing nothing.
        if "error" in result and not result.get("choices"):
            err = result["error"]
            message = err.get("message", err) if isinstance(err, dict) else err
            raise ProviderError(f"{RED}{label} Error: {message}{RESET}")
        choices = result.get("choices", [])
        if choices:
            return choices[0].get("message", {}).get("content", "").strip()
        raise ProviderError(f"{RED}Empty response from {label}.{RESET}")

    collected = []
    for event in iter_sse_events(resp):
        if "error" in event and not event.get("choices"):
            err = event["error"]
            message = err.get("message", err) if isinstance(err, dict) else err
            raise ProviderError(f"{RED}{label} Error: {message}{RESET}")
        for choice in event.get("choices", []):
            fragment = choice.get("delta", {}).get("content") or ""
            if fragment:
                spinner.stop()
                collected.append(fragment)
                on_chunk(fragment)
    if not collected:
        raise ProviderError(f"{RED}Empty response from {label}.{RESET}")
    return "".join(collected).strip()


def query_provider_openai(prompt: str, extra_web_context: str, config: dict, on_chunk=None) -> str:
    openai_conf = config.get("openai", {})
    api_key = openai_conf.get("api_key", "").strip()
    model = openai_conf.get("model", "gpt-4o-mini").strip()

    if not api_key:
        raise ProviderError(f"{RED}[-] Error: OpenAI API Key is not set!\n{RESET}"
                f"{CYAN}Run {BOLD}larp config{RESET}{CYAN} to set up your API key.{RESET}")

    endpoint = "https://api.openai.com/v1/chat/completions"

    payload = {
        "model": model,
        "messages": [
            {"role": "system", "content": build_system_prompt()},
            {"role": "user", "content": build_full_prompt(prompt, extra_web_context)}
        ]
    }
    if on_chunk:
        payload["stream"] = True

    req = urllib.request.Request(
        endpoint,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json"
        },
        method="POST"
    )

    spinner = Spinner(f"Larp AI [OpenAI/{model}] generating response...")
    spinner.start()

    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            if resp.status != 200:
                raise ProviderError(f"{RED}OpenAI API Error: HTTP status {resp.status}{RESET}")
            return read_openai_style_response(resp, spinner, on_chunk, "OpenAI API")
    except urllib.error.HTTPError as e:
        err_msg = e.read().decode("utf-8", errors="ignore")
        raise ProviderError(f"{RED}OpenAI API Error ({e.code}): {err_msg}{RESET}")
    except ProviderError:
        raise
    except Exception as e:
        raise ProviderError(f"{RED}OpenAI API Request Error: {e}{RESET}")
    finally:
        spinner.stop()


def get_openrouter_models(api_key: str = "") -> list:
    """Fetches the list of model IDs available on OpenRouter (public endpoint, key optional)."""
    try:
        req = urllib.request.Request(f"{OPENROUTER_URL}/models", method="GET")
        if api_key:
            req.add_header("Authorization", f"Bearer {api_key}")
        with urllib.request.urlopen(req, timeout=8) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return sorted(m.get("id", "") for m in data.get("data", []) if m.get("id"))
    except Exception:
        return []


def query_provider_openrouter(prompt: str, extra_web_context: str, config: dict, on_chunk=None) -> str:
    """OpenRouter — one API key for Claude, Gemini, GPT, Llama and ~400 other models.

    The API is OpenAI-compatible, so the payload matches query_provider_openai();
    only the endpoint, the auth header and the namespaced model IDs differ.
    """
    openrouter_conf = config.get("openrouter", {})
    api_key = openrouter_conf.get("api_key", "").strip()
    model = openrouter_conf.get("model", "anthropic/claude-sonnet-5").strip()

    if not api_key:
        raise ProviderError(f"{RED}[-] Error: OpenRouter API Key is not set!\n{RESET}"
                f"{CYAN}Run {BOLD}larp config{RESET}{CYAN} to set up your API key.{RESET}\n"
                f"{DIM}Get one at https://openrouter.ai/keys{RESET}")

    payload = {
        "model": model,
        "messages": [
            {"role": "system", "content": build_system_prompt()},
            {"role": "user", "content": build_full_prompt(prompt, extra_web_context)}
        ]
    }
    if on_chunk:
        payload["stream"] = True

    req = urllib.request.Request(
        f"{OPENROUTER_URL}/chat/completions",
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
            # Optional attribution headers — they place larp on OpenRouter's
            # app leaderboard and are ignored if the app is unknown.
            "HTTP-Referer": "https://github.com/dotdok132/LarpHelper",
            "X-Title": "LarpHelper"
        },
        method="POST"
    )

    spinner = Spinner(f"Larp AI [OpenRouter/{model}] generating response...")
    spinner.start()

    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            if resp.status != 200:
                raise ProviderError(f"{RED}OpenRouter Error: HTTP status {resp.status}{RESET}")
            return read_openai_style_response(resp, spinner, on_chunk, "OpenRouter")
    except urllib.error.HTTPError as e:
        err_msg = e.read().decode("utf-8", errors="ignore")
        if e.code == 401:
            raise ProviderError(f"{RED}OpenRouter Error (401): invalid or expired API key.{RESET}\n"
                    f"{CYAN}Check it with {BOLD}larp config{RESET}{CYAN} or generate a new one at https://openrouter.ai/keys{RESET}")
        if e.code == 402:
            raise ProviderError(f"{RED}OpenRouter Error (402): insufficient credits for model '{model}'.{RESET}\n"
                    f"{CYAN}Top up at https://openrouter.ai/credits, or switch to a cheaper model:{RESET}\n"
                    f"  {BOLD}larp config set openrouter.model <model-id>{RESET}")
        if e.code == 404:
            raise ProviderError(f"{RED}OpenRouter Error (404): model '{model}' does not exist.{RESET}\n"
                    f"{CYAN}List available models with {BOLD}larp config models{RESET}")
        raise ProviderError(f"{RED}OpenRouter Error ({e.code}): {err_msg}{RESET}")
    except ProviderError:
        raise
    except Exception as e:
        raise ProviderError(f"{RED}OpenRouter Request Error: {e}{RESET}")
    finally:
        spinner.stop()


PROVIDER_FUNCS = {
    "ollama": query_provider_ollama,
    "gemini": query_provider_gemini,
    "claude": query_provider_claude,
    "openai": query_provider_openai,
    "openrouter": query_provider_openrouter,
}


def describe_attempt(provider: str, model: str = "", config: dict = None) -> str:
    """Labels an attempt as provider/model.

    When no model override is set, the provider's configured model is resolved so
    two entries for the same provider are distinguishable in logs and reports.
    """
    if not model and config:
        model = str(config.get(provider, {}).get("model", "") or "")
    return f"{provider}/{model}" if model else provider


def build_attempt_chain(config: dict) -> list:
    """Returns [(provider, model_override), ...] — the active provider, then the fallbacks.

    The active provider always goes first, so the fallback chain is purely
    additive and `provider` keeps its meaning. Duplicates are dropped so an entry
    that repeats the active provider does not retry the same thing twice.
    """
    active = config.get("provider", "ollama").lower()
    attempts = [(active, "")]

    for entry in config.get("fallback_chain", []) or []:
        if not isinstance(entry, dict):
            continue
        provider = str(entry.get("provider", "")).lower().strip()
        model = str(entry.get("model", "") or "").strip()
        if provider in PROVIDER_FUNCS and (provider, model) not in attempts:
            attempts.append((provider, model))

    return attempts


def ask_ai(prompt: str, extra_web_context: str = "", on_chunk=None) -> str:
    """Sends the prompt to the active provider, falling back down the chain on failure.

    Raises ProviderError when every attempt fails. It used to *return* the
    failure report as if it were an answer, which meant `larp do` would offer to
    execute the error text as a shell command.

    `on_chunk` is forwarded to the provider for streaming; it is only called for
    the attempt that succeeds, so a failed provider cannot half-print an answer.
    """
    config = load_config()
    attempts = build_attempt_chain(config)
    failures = []

    for index, (provider, model_override) in enumerate(attempts):
        attempt_config = config
        if model_override:
            # Shallow-copy just the section being overridden, so the fallback
            # model does not leak into the saved configuration.
            attempt_config = dict(config)
            attempt_config[provider] = dict(config.get(provider, {}))
            attempt_config[provider]["model"] = model_override

        label = describe_attempt(provider, model_override, config)
        announced = {"done": False}

        def emit(fragment, label=label, index=index, announced=announced):
            # The attribution has to be printed before the first token, not
            # after the answer, or it would land at the bottom of the stream.
            if index > 0 and not announced["done"]:
                announced["done"] = True
                print(f"{DIM}[answered by {label}]{RESET}")
            on_chunk(fragment)

        try:
            response = PROVIDER_FUNCS[provider](
                prompt, extra_web_context, attempt_config, on_chunk=emit if on_chunk else None
            )
        except ProviderError as exc:
            failures.append((label, str(exc)))
            remaining = attempts[index + 1:]
            if remaining:
                next_label = describe_attempt(remaining[0][0], remaining[0][1], config)
                print(f"{YELLOW}[!] {label} failed. "
                      f"Falling back to {BOLD}{next_label}{RESET}{YELLOW}...{RESET}")
            continue

        if index > 0 and not announced["done"]:
            # Name whoever actually answered — a silent fallback can quietly move
            # a free-model workload onto a paid one.
            print(f"{DIM}[answered by {label}]{RESET}")
        save_history_entry(prompt, response, label)
        return response

    report = [f"{RED}[-] Every configured provider failed:{RESET}"]
    for label, message in failures:
        first_line = plain_text(message).strip().splitlines()[0] if message.strip() else "unknown error"
        report.append(f"  {PINK}{label}{RESET} — {first_line}")
    if len(attempts) == 1:
        report.append(f"\n{CYAN}Set up a fallback chain so larp can try another provider: "
                      f"{BOLD}larp fallback add <provider> [model]{RESET}")
    result = "\n".join(report)
    save_history_entry(prompt, result, "none")
    raise ProviderError(result)


def ask_ai_streamed(title: str, prompt: str, extra_web_context: str = "",
                    border_color: str = PINK) -> str:
    """Asks the AI and prints the answer as it is generated.

    Returns the complete answer, or "" if every provider failed (the failure is
    printed here so each command does not repeat the same error handling).
    """
    printer = StreamPrinter(title, border_color=border_color)
    try:
        answer = ask_ai(prompt, extra_web_context, on_chunk=printer.write)
    except ProviderError as exc:
        printer.finish()
        print(f"\n{exc}\n")
        return ""
    printer.finish()
    return answer


def ask_ai_quietly(prompt: str, extra_web_context: str = "") -> str:
    """Asks the AI without streaming, printing the failure instead of raising.

    Used by the commands that parse the answer before showing anything.
    """
    try:
        return ask_ai(prompt, extra_web_context)
    except ProviderError as exc:
        print(f"\n{exc}\n")
        return ""


# =============================================================================
# LARP FETCH / NEOFETCH REPLACEMENT (`larp fetch`)
# =============================================================================

def cmd_fetch():
    """Aesthetic pastel system informer for Larp Linux and any Linux distribution."""
    user = os.environ.get("USER", "user")
    host = os.environ.get("HOSTNAME") or socket.gethostname() or "linux"
    
    os_name = "Linux"
    if os.path.exists("/etc/os-release"):
        try:
            with open("/etc/os-release", "r") as f:
                for line in f:
                    if line.startswith("PRETTY_NAME="):
                        os_name = line.split("=")[1].strip().strip('\"')
                        break
        except Exception:
            pass

    kernel = subprocess.check_output(["uname", "-sr"], text=True).strip() if shutil.which("uname") else "Linux"
    shell = os.environ.get("SHELL", "/bin/bash").split("/")[-1]
    wm = os.environ.get("XDG_CURRENT_DESKTOP", "Wayland")
    
    pkg_name, _, _, _ = detect_package_manager()
    init_name, _, _, _ = detect_init_system()
    count_commands = {
        "pacman": "pacman -Qq | wc -l",
        "apt": "dpkg-query -f '.\\n' -W | wc -l",
        "dnf": "rpm -qa | wc -l",
        "zypper": "rpm -qa | wc -l",
        "apk": "apk info | wc -l",
        "xbps": "xbps-query -l | wc -l",
        "eopkg": "eopkg li -i | wc -l",
        "emerge": "qlist -I | wc -l",
    }
    pkgs_count = "?"
    try:
        count_cmd = count_commands.get(pkg_name)
        if count_cmd:
            pkgs_count = subprocess.check_output(count_cmd, shell=True, text=True).strip() or "?"
    except Exception:
        pass

    uptime_str = "0m"
    try:
        with open("/proc/uptime", "r") as f:
            up_secs = float(f.readline().split()[0])
            mins = int(up_secs // 60)
            hours = mins // 60
            uptime_str = f"{hours}h {mins % 60}m"
    except Exception:
        pass

    config = load_config()
    ai_provider = config.get("provider", "ollama").upper()

    logo = [
        f"{PINK}   ╭────────────╮   {RESET}",
        f"{PINK}   │    Larp    │   {RESET}",
        f"{PINK}   │  OS Linux  │   {RESET}",
        f"{PINK}   ╰────────────╯   {RESET}",
        f"{CYAN}   ─── v{__version__} ───  {RESET}"
    ]

    info = [
        f"{BOLD}{PINK}{user}{RESET}@{BOLD}{CYAN}{host}{RESET}",
        f"{GRAY}─────────────────────────────{RESET}",
        f"{CYAN}OS:{RESET}          {WHITE}{os_name}{RESET}",
        f"{CYAN}Kernel:{RESET}      {WHITE}{kernel}{RESET}",
        f"{CYAN}Init System:{RESET} {WHITE}{init_name}{RESET}",
        f"{CYAN}Packages:{RESET}    {WHITE}{pkgs_count} ({pkg_name}){RESET}",
        f"{CYAN}Shell:{RESET}       {WHITE}{shell}{RESET}",
        f"{CYAN}Compositor:{RESET}  {PINK}{wm}{RESET}",
        f"{CYAN}AI Engine:{RESET}   {BOLD}{PINK}{ai_provider}{RESET}",
        "",
        f"{PINK}███{DEEP_PINK}███{CYAN}███{LIGHT_CYAN}███{PURPLE}███{WHITE}███{RESET}"
    ]

    print()
    max_lines = max(len(logo), len(info))
    for i in range(max_lines):
        l_line = logo[i] if i < len(logo) else "                    "
        r_line = info[i] if i < len(info) else ""
        print(f"{l_line}   {r_line}")
    print()


