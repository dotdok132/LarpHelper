def cmd_get_list():
    print_banner()
    recipes = get_all_recipes()
    print(f"{BOLD}{PINK}Available Software Recipes & Packs (Larp-Repo & Custom):{RESET}\n")
    for name, info in recipes.items():
        tag = f"{LIGHT_PINK}[Custom]{RESET} " if name in load_custom_recipes() else ""
        print(f"  {PINK}{BOLD}{name:<14}{RESET} {CYAN}─{RESET} {tag}{info['desc']}")
        print(f"  {DIM}                Command: {info['cmd']}{RESET}\n")
    print(f"{DIM}To install execute: {RESET}{CYAN}larp get <package_name>{RESET}\n")


def cmd_get_create(args: list):
    print_banner()
    if not args:
        print(f"{PINK}Larp AI Pack Architect with Web Access!{RESET}")
        print(f"{CYAN}Describe the software pack you need to construct:{RESET}")
        try:
            task_desc = input(" > ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nCancelled.")
            sys.exit(0)
    else:
        task_desc = " ".join(args)

    if not task_desc:
        print(f"{YELLOW}[!] Task description cannot be empty.{RESET}")
        sys.exit(1)

    print(f"\n{CYAN}Searching Linux repositories for:{RESET} {BOLD}{task_desc}{RESET}...")
    web_context = get_full_web_context(task_desc)

    print(f"{CYAN}Designing verified package suite...{RESET}\n")

    pkg_name, install_cmd, _, _ = detect_package_manager()

    prompt = (
        f"The user wants to create a software pack for the task:\n\"{task_desc}\"\n\n"
        f"RULES:\n"
        f"1. Choose ONLY real, existing Linux packages for active package manager: {pkg_name}.\n"
        f"2. Give a brief explanation (2 sentences).\n"
        f"3. Provide a single installation command: `{install_cmd} <packages>`\n"
        f"4. End response with: PACK_NAME: <short-pack-name>"
    )

    response = ask_ai_quietly(prompt, extra_web_context=web_context)
    if not response:
        return

    cmd_to_run = ""
    suggested_name = "custom-pack"
    
    clean_lines = []
    for line in response.splitlines():
        if line.startswith("PACK_NAME:"):
            parsed = line.replace("PACK_NAME:", "").strip().lower()
            if parsed and parsed not in ["makefile", "bash", "sh"]:
                suggested_name = parsed
            continue

        if not cmd_to_run:
            install_tokens = [
                "sudo pacman", "sudo apt", "sudo dnf", "sudo zypper", "sudo apk",
                "sudo xbps-install", "sudo eopkg", "sudo emerge", "curl",
            ]
            extracted = extract_command_from_line(line, install_tokens)
            if extracted:
                cmd_to_run = sanitize_shell_command(extracted)

        clean_lines.append(line)

    print_box("Package Pack Blueprint (Larp AI + Web)", "\n".join(clean_lines), border_color=PINK)
    print()

    if cmd_to_run:
        cmd_to_run = sanitize_shell_command(cmd_to_run)
        print(f"{CYAN}Proposed installation command:{RESET}\n  {BOLD}{cmd_to_run}{RESET}\n")
        try:
            ans = input(f"{PINK}Execute installation for '{suggested_name}' right now? (y/N): {RESET}").strip().lower()
            if ans in ["y", "yes", "yeah"] and confirm_destructive(cmd_to_run):
                print(f"\n{CYAN}Running installation...{RESET}\n")
                res = subprocess.run(cmd_to_run, shell=True)
                if res.returncode == 0:
                    print(f"\n{GREEN}[+] Pack '{suggested_name}' installed successfully!{RESET}")
                else:
                    print(f"\n{RED}[-] Installation failed.{RESET}")

            save_ans = input(f"\n{PINK}Save recipe '{suggested_name}' to your permanent collection (larp get {suggested_name})? (y/N): {RESET}").strip().lower()
            if save_ans in ["y", "yes", "yeah"]:
                save_custom_recipe(suggested_name, f"Custom Pack: {task_desc}", cmd_to_run)

        except (KeyboardInterrupt, EOFError):
            print("\nCancelled.")


