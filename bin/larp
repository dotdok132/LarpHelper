def cmd_get_list():
    print_banner()
    recipes = get_all_recipes()
    print(f"{BOLD}{PINK}Available Software Recipes & Packs (Larp-Repo & Custom):{RESET}\n")
    for name, info in recipes.items():
        tag = f"{LIGHT_PINK}[Custom]{RESET} " if name in load_custom_recipes() else ""
        print(f"  {PINK}{BOLD}{name:<14}{RESET} {CYAN}─{RESET} {tag}{info['desc']}")
        print(f"  {DIM}                Command: {info['cmd']}{RESET}\n")
    print(f"{DIM}To install execute: {RESET}{CYAN}larp get <package_name>{RESET}\n")


def cmd_get_create(args: list):
    print_banner()
    if not args:
        print(f"{PINK}LarpLinux AI Pack Architect with Web Access!{RESET}")
        print(f"{CYAN}Describe the software pack you need to construct:{RESET}")
        try:
            task_desc = input(" > ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nCancelled.")
            sys.exit(0)
    else:
        task_desc = " ".join(args)

    if not task_desc:
        print(f"{YELLOW}[!] Task description cannot be empty.{RESET}")
        sys.exit(1)

    print(f"\n{CYAN}Searching Arch Linux & AUR repositories for:{RESET} {BOLD}{task_desc}{RESET}...")
    web_context = get_full_web_context(task_desc)

    print(f"{CYAN}Designing verified package suite...{RESET}\n")

    prompt = (
        f"The user wants to create a software pack for the task:\n\"{task_desc}\"\n\n"
        f"RULES:\n"
        f"1. Choose ONLY real, existing Arch Linux / AUR packages.\n"
        f"2. Give a brief explanation (2 sentences).\n"
        f"3. Provide a single installation command: `sudo pacman -S --needed <packages>`\n"
        f"4. End response with: PACK_NAME: <short-pack-name>"
    )

    response = query_ollama(prompt, extra_web_context=web_context)

    cmd_to_run = ""
    suggested_name = "custom-pack"
    
    clean_lines = []
    for line in response.splitlines():
        if line.startswith("PACK_NAME:"):
            parsed = line.replace("PACK_NAME:", "").strip().lower()
            if parsed and parsed not in ["makefile", "bash", "sh"]:
                suggested_name = parsed
            continue

        if any(token in line for token in ["sudo pacman", "curl", "yay", "paru"]):
            clean_line = sanitize_shell_command(line)
            extracted = re.sub(r'^.*?(sudo pacman|curl|yay|paru)', r'\1', clean_line)
            if not cmd_to_run:
                cmd_to_run = sanitize_shell_command(extracted)

        clean_lines.append(line)

    print_box("Package Pack Blueprint (Larp AI + Web)", "\n".join(clean_lines), border_color=PINK)
    print()

    if cmd_to_run:
        cmd_to_run = sanitize_shell_command(cmd_to_run)
        print(f"{CYAN}Proposed installation command:{RESET}\n  {BOLD}{cmd_to_run}{RESET}\n")
        try:
            ans = input(f"{PINK}Execute installation for '{suggested_name}' right now? (y/N): {RESET}").strip().lower()
            if ans in ["y", "yes", "yeah"]:
                print(f"\n{CYAN}Running installation...{RESET}\n")
                res = subprocess.run(cmd_to_run, shell=True)
                if res.returncode == 0:
                    print(f"\n{GREEN}[+] Pack '{suggested_name}' installed successfully!{RESET}")
                else:
                    print(f"\n{RED}[-] Installation failed.{RESET}")

            save_ans = input(f"\n{PINK}Save recipe '{suggested_name}' to your permanent collection (larp get {suggested_name})? (y/N): {RESET}").strip().lower()
            if save_ans in ["y", "yes", "yeah"]:
                save_custom_recipe(suggested_name, f"Custom Pack: {task_desc}", cmd_to_run)

        except (KeyboardInterrupt, EOFError):
            print("\nCancelled.")


def cmd_why(args: list):
    if not args:
        print(f"{YELLOW}[!] Specify a question for larp why.{RESET}")
        print(f"   {DIM}Example: larp why is wayland smooth?{RESET}")
        sys.exit(1)

    question = " ".join(args)
    print_banner()
    print(f"{BOLD}{CYAN}Question:{RESET} {question}\n")

    print(f"{CYAN}Searching Web & Arch Repositories (DuckDuckGo + Arch DB)...{RESET}")
    web_context = get_full_web_context(question)

    response = query_ollama(question, extra_web_context=web_context)
    config = load_config()
    p_name = config.get("provider", "ollama").upper()
    print_box(f"Larp AI [{p_name}] (Web-Search Enabled)", response, border_color=PINK)
    print()


def cmd_fix(args: list = None):
    print_banner()
    print(f"{CYAN}Reading recent critical system logs (journalctl -p 3 -n 20)...{RESET}\n")

    try:
        cmd = ["journalctl", "-p", "3", "-n", "20", "--no-pager"]
        res = subprocess.run(cmd, capture_output=True, text=True, check=False)
        logs = res.stdout.strip()
    except Exception as e:
        print(f"{RED}[-] Error executing journalctl: {e}{RESET}")
        sys.exit(1)

    if not logs:
        print(f"{GREEN}[+] No critical system errors (priority <= 3) found in journalctl! System is stable.{RESET}\n")
        return

    prompt = (
        f"Here are the 20 most recent critical system logs from LarpLinux (journalctl -p 3 -n 20):\n\n"
        f"```\n{logs}\n```\n\n"
        f"1. Explain the root cause in 2-3 brief sentences.\n"
        f"2. Provide an exact one-liner bash resolution command formatted as: FIX_CMD: <fix_command>"
    )

    response = query_ollama(prompt)
    config = load_config()
    p_name = config.get("provider", "ollama").upper()

    clean_lines = []
    cmd_to_fix = ""

    for line in response.splitlines():
        if "FIX_CMD:" in line:
            extracted = line.split("FIX_CMD:")[1].strip()
            cmd_to_fix = sanitize_shell_command(extracted)
            continue
        elif any(token in line for token in ["sudo systemctl", "sudo pacman", "systemctl restart", "sudo rm", "sudo chmod", "sudo sed"]):
            clean_line = sanitize_shell_command(line)
            extracted = re.sub(r'^.*?(sudo systemctl|systemctl|sudo pacman|sudo rm|sudo chmod|sudo sed)', r'\1', clean_line)
            if not cmd_to_fix:
                cmd_to_fix = sanitize_shell_command(extracted)
        clean_lines.append(line)

    if cmd_to_fix:
        cmd_to_fix = sanitize_shell_command(cmd_to_fix)

    print_box(f"Diagnostics & Resolution [{p_name}]", "\n".join(clean_lines), border_color=PINK)
    print()

    if cmd_to_fix:
        print(f"{CYAN}Proposed automatic repair command:{RESET}\n  {BOLD}{cmd_to_fix}{RESET}\n")
        auto_yes = (args and any(a in ["-y", "--yes", "auto"] for a in args)) or config.get("auto_fix", True)
        try:
            if not auto_yes:
                ans = input(f"{PINK}Execute automatic repair right now? (y/N): {RESET}").strip().lower()
                should_run = ans in ["y", "yes", "yeah"]
            else:
                print(f"{GREEN}[Auto-Repair Engine] Auto-Repair enabled in configuration. Applying fixes instantly...{RESET}")
                should_run = True

            if should_run:
                print(f"\n{CYAN}Executing repair command...{RESET}\n")
                res = subprocess.run(cmd_to_fix, shell=True)
                if res.returncode == 0:
                    print(f"\n{GREEN}[+] System repair applied successfully!{RESET}\n")
                else:
                    print(f"\n{RED}[-] Repair command exited with code {res.returncode}.{RESET}\n")
        except (KeyboardInterrupt, EOFError):
            print("\nCancelled.")


def cmd_get(args: list):
    if not args or args[0] in ["--list", "-l", "list"]:
        cmd_get_list()
        return

    pkg_name = args[0].lower()
    print_banner()
    recipes = get_all_recipes()

    if pkg_name in recipes:
        recipe = recipes[pkg_name]
        cmd_str = recipe["cmd"]
        desc = recipe["desc"]

        print(f"{PINK}[Larp-Repo]{RESET} {CYAN}Running build recipe:{RESET} {BOLD}{pkg_name}{RESET} ({desc})")
        print(f"{DIM}Executing command: {cmd_str}{RESET}\n")
        try:
            res = subprocess.run(cmd_str, shell=True)
            if res.returncode == 0:
                print(f"\n{GREEN}[+] Recipe '{pkg_name}' installed successfully!{RESET}\n")
            else:
                print(f"\n{RED}[-] Error installing package '{pkg_name}' (exit code: {res.returncode}){RESET}\n")
        except Exception as e:
            print(f"\n{RED}[-] Execution error: {e}{RESET}\n")
    else:
        print(f"{PINK}[Larp-Repo]{RESET} {CYAN}Searching recipe registry for:{RESET} {BOLD}{pkg_name}{RESET}")
        print(f"{DIM}─── Scanning official LarpLinux repository...{RESET}")
        time.sleep(0.3)
        print(f"\n{LIGHT_PINK}Recipe '{pkg_name}' not found in Larp-Repo registry.{RESET}")
        print(f"{DIM}You can generate it automatically using: {RESET}{CYAN}larp get-create {pkg_name}{RESET}\n")


def main():
    if len(sys.argv) < 2:
        cmd_help()
        sys.exit(0)

    subcommand = sys.argv[1].lower()
    args = sys.argv[2:]

    if subcommand in ["help", "-h", "--help"]:
        cmd_help()
    elif subcommand in ["fetch", "neofetch"]:
        cmd_fetch()
    elif subcommand in ["code", "script"]:
        cmd_code(args)
    elif subcommand in ["translate", "tr"]:
        cmd_translate(args)
    elif subcommand in ["backup", "snapshot"]:
        cmd_backup()
    elif subcommand in ["alias", "setup-aliases"]:
        cmd_alias()
    elif subcommand == "config":
        cmd_config(args)
    elif subcommand == "do":
        cmd_do(args)
    elif subcommand == "clean":
        cmd_clean()
    elif subcommand in ["bench", "benchmark", "speedtest"]:
        cmd_bench()
    elif subcommand in ["history", "hist", "logs"]:
        cmd_history()
    elif subcommand == "status":
        cmd_status()
    elif subcommand in ["monitor", "top"]:
        cmd_monitor()
    elif subcommand == "chat":
        cmd_chat()
    elif subcommand == "why":
        cmd_why(args)
    elif subcommand == "fix":
        cmd_fix(args)
    elif subcommand == "get":
        cmd_get(args)
    elif subcommand in ["get-list", "list", "packs"]:
        cmd_get_list()
    elif subcommand in ["get-create", "create-pack", "create"]:
        cmd_get_create(args)
    else:
        print(f"{RED}[-] Unknown command: '{subcommand}'{RESET}\n")
        cmd_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
