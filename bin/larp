def cmd_alias():
    """Installs convenient terminal aliases into ~/.bashrc."""
    print_banner()
    aliases = """
# --- LarpLinux Shortcuts ---
alias l='larp'
alias ld='larp do'
alias lw='larp why'
alias lc='larp chat'
alias lg='larp get'
alias lf='larp fetch'
"""
    bashrc = os.path.expanduser("~/.bashrc")
    try:
        with open(bashrc, "a", encoding="utf-8") as f:
            f.write(aliases)
        print(f"{GREEN}[+] Short aliases (l, ld, lw, lc, lg, lf) successfully added to ~/.bashrc!{RESET}")
        print(f"{DIM}Run 'source ~/.bashrc' to apply changes.{RESET}\n")
    except Exception as e:
        print(f"{RED}[-] Error adding aliases: {e}{RESET}\n")


# =============================================================================
# AUTONOMOUS SHELL COPILOT (`larp do <task>`)
# =============================================================================

def cmd_do(args: list):
    """Autonomous AI Shell Copilot — translates natural instructions into bash commands."""
    print_banner()
    if not args:
        print(f"{PINK}LarpLinux Autonomous Shell Copilot!{RESET}")
        print(f"{CYAN}Describe the terminal action you want to execute:{RESET}")
        try:
            task = input(" > ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nCancelled.")
            return
    else:
        task = " ".join(args)

    if not task:
        print(f"{YELLOW}[!] Instruction cannot be empty.{RESET}")
        return

    print(f"{CYAN}AI Copilot designing command pipeline for:{RESET} {BOLD}{task}{RESET}...\n")

    prompt = (
        f"The user wants to perform the following terminal task in LarpLinux:\n\"{task}\"\n\n"
        f"Provide a SINGLE safe and exact one-liner bash command pipeline.\n"
        f"Do NOT output any markdown or explanation before/after! Only the one-liner command."
    )

    raw_response = query_ollama(prompt)
    cmd = sanitize_shell_command(raw_response)

    print_box("Proposed Terminal Command", f"{BOLD}{WHITE}{cmd}{RESET}", border_color=CYAN)
    print()

    try:
        ans = input(f"{PINK}Execute this command right now? (y/N): {RESET}").strip().lower()
        if ans in ["y", "yes", "yeah"]:
            print(f"\n{CYAN}Running command...{RESET}\n")
            res = subprocess.run(cmd, shell=True)
            if res.returncode == 0:
                print(f"\n{GREEN}[+] Command executed successfully!{RESET}\n")
            else:
                print(f"\n{RED}[-] Command exited with code {res.returncode}.{RESET}\n")
    except (KeyboardInterrupt, EOFError):
        print("\nCancelled.")


# =============================================================================
# SYSTEM CLEANER & OPTIMIZER (`larp clean`)
# =============================================================================

def cmd_clean():
    """Disk cleanup and system optimization wizard."""
    print_banner()
    print(f"{BOLD}{PINK}LarpLinux System Cleanup & Optimization Wizard:{RESET}\n")

    cleaned_items = []

    try:
        orphans = subprocess.check_output("pacman -Qtdq", shell=True, text=True, stderr=subprocess.DEVNULL).strip().splitlines()
        if orphans:
            print(f"  {CYAN}Found orphan packages:{RESET} {len(orphans)} ({', '.join(orphans[:5])}...)")
            ans = input(f"  {PINK}Remove orphan packages (sudo pacman -Rns ...)? (y/N): {RESET}").strip().lower()
            if ans in ["y", "yes", "yeah"]:
                subprocess.run(f"sudo pacman -Rns --noconfirm {' '.join(orphans)}", shell=True)
                cleaned_items.append("Orphan pacman packages")
        else:
            print(f"  {GREEN}[+] No orphan packages found.{RESET}")
    except Exception:
        print(f"  {GREEN}[+] No orphan packages found.{RESET}")

    cache_dir = "/var/cache/pacman/pkg"
    if os.path.exists(cache_dir):
        try:
            print(f"\n  {CYAN}Cleaning unneeded pacman package cache...{RESET}")
            ans = input(f"  {PINK}Clean package cache (sudo pacman -Sc)? (y/N): {RESET}").strip().lower()
            if ans in ["y", "yes", "yeah"]:
                subprocess.run("sudo pacman -Sc --noconfirm", shell=True)
                cleaned_items.append("Pacman package cache")
        except Exception:
            pass

    print(f"\n  {CYAN}Cleaning old systemd logs (older than 7 days)...{RESET}")
    ans = input(f"  {PINK}Vacuum journalctl logs? (y/N): {RESET}").strip().lower()
    if ans in ["y", "yes", "yeah"]:
        subprocess.run("sudo journalctl --vacuum-time=7d", shell=True)
        cleaned_items.append("Journalctl logs")

    user_cache = os.path.expanduser("~/.cache")
    if os.path.exists(user_cache):
        print(f"\n  {CYAN}Cleaning user temp cache ({user_cache})...{RESET}")
        ans = input(f"  {PINK}Clear thumbnails and font cache? (y/N): {RESET}").strip().lower()
        if ans in ["y", "yes", "yeah"]:
            subprocess.run("rm -rf ~/.cache/thumbnails/* ~/.cache/fontconfig/* 2>/dev/null", shell=True)
            cleaned_items.append("Thumbnails & font cache")

    print(f"\n{GREEN}[+] Optimization complete! Cleaned: {', '.join(cleaned_items) if cleaned_items else 'system already optimal'}.{RESET}\n")


# =============================================================================
# AI BENCHMARK & SPEEDTEST (`larp bench`)
# =============================================================================

def cmd_bench():
    """Benchmark speed and latency of configured AI providers."""
    print_banner()
    print(f"{BOLD}{PINK}LarpLinux AI Provider Benchmark & Speedtest:{RESET}\n")

    config = load_config()
    test_prompt = "Write three brief sentences highlighting key advantages of Linux."

    providers_to_test = [
        ("Ollama (Local)", "ollama", query_provider_ollama),
        ("Google Gemini API", "gemini", query_provider_gemini),
        ("Anthropic Claude API", "claude", query_provider_claude),
        ("OpenAI API", "openai", query_provider_openai)
    ]

    results = []

    for name, p_id, func in providers_to_test:
        if p_id != "ollama" and not config.get(p_id, {}).get("api_key"):
            results.append(f"  {GRAY}{name:<24}{RESET} ── {YELLOW}API key not configured{RESET}")
            continue

        start_t = time.time()
        try:
            resp = func(test_prompt, "", config)
            elapsed = round(time.time() - start_t, 2)
            if "Error" in resp or "HTTP" in resp:
                results.append(f"  {PINK}{name:<24}{RESET} ── {RED}Response Error{RESET}")
            else:
                words_count = len(resp.split())
                wps = round(words_count / elapsed, 1) if elapsed > 0 else 0
                results.append(f"  {PINK}{BOLD}{name:<24}{RESET} ── {GREEN}{elapsed}s{RESET} ({wps} words/sec, {words_count} words)")
        except Exception as e:
            results.append(f"  {PINK}{name:<24}{RESET} ── {RED}Failed ({e}){RESET}")

    print_box("AI Provider Speedtest Results", "\n".join(results), border_color=CYAN)
    print()


# =============================================================================
# QUERY & CONVERSATION HISTORY (`larp history`)
# =============================================================================

def cmd_history():
    """Displays prompt history and AI responses."""
    print_banner()
    if not os.path.exists(HISTORY_FILE):
        print(f"{LIGHT_PINK}Query history is empty.{RESET}\n")
        return

    try:
        with open(HISTORY_FILE, "r", encoding="utf-8") as f:
            history = json.load(f)
    except Exception:
        print(f"{RED}Error reading history file.{RESET}\n")
        return

    if not history:
        print(f"{LIGHT_PINK}Query history is empty.{RESET}\n")
        return

    print(f"{BOLD}{PINK}Recent {len(history)} Larp AI Queries:{RESET}\n")
    lines = []
    for idx, item in enumerate(reversed(history[:15]), 1):
        ts = item.get("timestamp", "")
        prov = item.get("provider", "").upper()
        q = item.get("query", "")
        lines.append(f" {PINK}{idx:2d}.{RESET} [{CYAN}{ts}{RESET}] ({BOLD}{prov}{RESET}) {BOLD}{q}{RESET}")

    print("\n".join(lines))
    print(f"\n{DIM}History log path: {HISTORY_FILE}{RESET}\n")


